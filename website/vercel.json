      "permanent": true
    },
    {
      "source": "/:state/hikes/at-terminu",
      "destination": "/:state/hikes/at-terminus",
      "permanent": true
    },
    {
      "source": "/:state/hikes/avalanche-pas",
      "destination": "/:state/hikes/avalanche-pass",
      "permanent": true
    },
    {
      "source": "/:state/hikes/wildernes",
      "destination": "/:state/hikes/wilderness",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
