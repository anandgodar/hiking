{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.summitseeker.io"
        }
      ],
      "destination": "https://summitseeker.io/:path*",
      "permanent": true
    },
    {
      "source": "/discover/strenuou",
      "destination": "/discover/strenuous",
      "permanent": true
    },
    {
      "source": "/discover/easy-acces",
      "destination": "/discover/easy-access",
      "permanent": true
    },
    {
      "source": "/discover/instagram-famou",
      "destination": "/discover/instagram-famous",
      "permanent": true
    },
    {
      "source": "/discover/at-terminu",
      "destination": "/discover/at-terminus",
      "permanent": true
    },
    {
      "source": "/discover/avalanche-pas",
      "destination": "/discover/avalanche-pass",
      "permanent": true
    },
    {
      "source": "/discover/wildernes",
      "destination": "/discover/wilderness",
      "permanent": true
    },
    {
      "source": "/:state/hikes/strenuou",
      "destination": "/:state/hikes/strenuous",
      "permanent": true
    },
    {
      "source": "/:state/hikes/easy-acces",
