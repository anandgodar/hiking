---
/**
 * Mountain Detail Page
 * Location: src/pages/[state]/hikes/[slug].astro
 *
 * FIXED: Import paths updated for /hikes/ subdirectory (3 levels deep)
 * FIXED: Now handles both 'trails' and 'trails_config' data structures
 */

// Layout - now 3 levels up
import Layout from '../../../layouts/Layout.astro';

// Phase 1-3 Components
import FAQSection from '../../../components/FAQSection.astro';
import SeasonalGuide from '../../../components/SeasonalGuide.astro';
import SafetySection from '../../../components/SafetySection.astro';
import DownloadsSection from '../../../components/DownloadsSection.astro';

// Existing Components
import TrailSchema from '../../../components/TrailSchema.astro';
import SocialPulse from '../../../components/SocialPulse.astro';
import NearbyPeaksAstro from '../../../components/NearbyPeaks.astro';
import SiteFooter from '../../../components/SiteFooter.astro';

// React Components
import TrailDashboard from '../../../components/TrailDashboard.jsx';
import WeatherWidget from '../../../components/WeatherWidget.jsx';
import SavePeakButton from '../../../components/SavePeakButton.jsx';
import { isPublishReady } from '../../../lib/publishReady.js';
import cities from '../../../data-static/cities.json';

// REQUIRED: getStaticPaths for dynamic routes
export async function getStaticPaths() {
  // Data is now 3 levels up
  const modules = import.meta.glob('../../../data/*/*.json', { eager: true });

  return Object.entries(modules)
    .map(([path, data]) => data.default || data)
    // Only build pages for route-complete trails; drafts/stubs are excluded.
    .filter(isPublishReady)
    .map(mountain => {
      // Normalize state_slug
      let stateSlug = mountain.state_slug || 'new-hampshire';
      if (stateSlug === 'nh') stateSlug = 'new-hampshire';
      if (stateSlug === 'me') stateSlug = 'maine';
      if (stateSlug === 'vt') stateSlug = 'vermont';
      if (stateSlug === 'ny') stateSlug = 'new-york';

      return {
        params: {
          state: stateSlug,
          slug: mountain.slug
        },
        props: { mountain: { ...mountain, state_slug: stateSlug } }
      };
    });
}

const { mountain } = Astro.props;

// Nearby Peaks must only link to pages that exist. Draft trails don't
// generate pages (publish gate), so filter their slugs out here or the
// sidebar links 404.
const liveFiles = import.meta.glob('../../../data/*/*.json', { eager: true });
const liveMountains = Object.values(liveFiles)
  .map(f => f.default || f)
  .filter(isPublishReady);
const liveSlugs = new Set(liveMountains.map(m => m.slug));
mountain.nearby_peaks = (mountain.nearby_peaks || [])
  .filter(p => liveSlugs.has(p.slug));

// highest-peaks pages only generate for states with ≥3 live trails — don't
// link to one that doesn't exist (Nebraska has 2).
const norm = (s) => (s === 'nh' ? 'new-hampshire' : s === 'me' ? 'maine' : s === 'vt' ? 'vermont' : s === 'ny' ? 'new-york' : s);
const stateLive = liveMountains.filter(m => norm(m.state_slug) === mountain.state_slug);
const stateLiveCount = stateLive.length;
const hasHighestPeaksPage = stateLiveCount >= 3;

// Related trails: same state, prefer same difficulty, closest in elevation.
// Hub-and-spoke internal linking — every trail page links onward to more
// trail pages plus its state/difficulty hubs.
const myDifficulty = mountain.trails?.[0]?.difficulty || mountain.trails?.[0]?.stats?.difficulty || null;
const nearbySlugs = new Set((mountain.nearby_peaks || []).map(p => p.slug));
const relatedTrails = stateLive
  .filter(m => m.slug !== mountain.slug && !nearbySlugs.has(m.slug))
  .map(m => ({
    name: m.name,
    slug: m.slug,
    state_slug: norm(m.state_slug),
    elevation: m.elevation,
    difficulty: m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || null,
    distance: m.trails?.[0]?.stats?.distance || null,
  }))
  .sort((a, b) => {
    const da = (a.difficulty === myDifficulty) ? 0 : 1;
    const db = (b.difficulty === myDifficulty) ? 0 : 1;
    if (da !== db) return da - db;
    return Math.abs((a.elevation || 0) - (mountain.elevation || 0))
         - Math.abs((b.elevation || 0) - (mountain.elevation || 0));
  })
  .slice(0, 4);

// Nearest city hub page, if this trail is within its 100-mile radius and the
// page exists (same ≥5-trails rule as the /near generator).
const havMi = (aLat, aLon, bLat, bLon) => {
  const R = 3959;
  const dLat = (bLat - aLat) * Math.PI / 180;
  const dLon = (bLon - aLon) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2 + Math.cos(aLat * Math.PI / 180) * Math.cos(bLat * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
};
// Hand-authored /near/*.astro pages are kept out of cities.json (they take
// precedence over the [city].astro dynamic route), so the nearest-city
// lookup below needs its own copy — otherwise a trail near a hand-authored
// city silently links to the next-closest programmatic one instead.
const HAND_MADE_CITIES = [
  { slug: 'boston', name: 'Boston', lat: 42.3601, lon: -71.0589 },
  { slug: 'new-york-city', name: 'New York City', lat: 40.7128, lon: -74.006 },
  { slug: 'san-francisco', name: 'San Francisco', lat: 37.7749, lon: -122.4194 },
  { slug: 'los-angeles', name: 'Los Angeles', lat: 34.0522, lon: -118.2437 },
  { slug: 'portland-maine', name: 'Portland, ME', lat: 43.6591, lon: -70.2568 },
  { slug: 'burlington-vermont', name: 'Burlington, VT', lat: 44.4759, lon: -73.2121 },
  { slug: 'providence', name: 'Providence, RI', lat: 41.8240, lon: -71.4128 },
  { slug: 'hartford', name: 'Hartford, CT', lat: 41.7658, lon: -72.6734 },
  { slug: 'albany', name: 'Albany, NY', lat: 42.6526, lon: -73.7562 },
  { slug: 'philadelphia', name: 'Philadelphia, PA', lat: 39.9526, lon: -75.1652 },
  { slug: 'pittsburgh', name: 'Pittsburgh, PA', lat: 40.4406, lon: -79.9959 },
];
const allCities = [...HAND_MADE_CITIES, ...cities];

// These hand-authored pages filter on trailhead coordinates + a 120-minute
// drive cap (see e.g. near/philadelphia.astro), not just summit-to-summit
// distance — so this lookup needs the same predicate for them, or a trail
// can get linked to a city whose own page doesn't actually list it (e.g. a
// trail 92mi/123min from Philadelphia passed the generic <=100mi check here
// but fails philadelphia.astro's <=100mi && <=120min filter).
const strictDriveTimeSlugs = new Set(['providence', 'hartford', 'albany', 'philadelphia', 'pittsburgh']);
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') return start;
  return [m.lat, m.lon];
};

let cityLink = null;
if (mountain.lat && mountain.lon) {
  const [thLat, thLon] = trailheadCoords(mountain);
  const candidates = allCities
    .map(c => {
      const strict = strictDriveTimeSlugs.has(c.slug);
      const mi = havMi(c.lat, c.lon, strict ? thLat : mountain.lat, strict ? thLon : mountain.lon);
      const driveTime = Math.round(mi / 45 * 60);
      return { ...c, mi, strict, ok: strict ? (mi <= 100 && driveTime <= 120) : mi <= 100 };
    })
    .filter(c => c.ok)
    .sort((a, b) => a.mi - b.mi);
  for (const c of candidates) {
    const n = liveMountains.filter(m => m.lat && m.lon && havMi(c.lat, c.lon, m.lat, m.lon) <= 100).length;
    if (n >= 5) { cityLink = c; break; }
  }
}

// Extract page content
// No local default-hero asset exists, so this used to render a broken <img>
// on every trail without its own photo (591 live pages). A generic mountain
// photo is a reasonable placeholder, but claiming it IS this peak (the old
// alt text always said "{name} summit view") would be misleading — the alt
// text and a small on-image label only make that claim when it's real.
const DEFAULT_HERO = 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&q=80&w=2000';
const hasRealHero = Boolean(mountain.mountain_hero);
const heroSrc = mountain.mountain_hero || DEFAULT_HERO;
const heroAlt = hasRealHero
  ? `${mountain.name} summit view`
  : 'Mountain wilderness landscape (photo not yet available for this specific peak)';

const pageContent = mountain.page_content || {};
const engagement = mountain.engagement || {};
const seo = mountain.seo || {};

// FIXED: Check both data structures for trails
const trails = mountain.trails || mountain.trails_config || [];
const hasTrails = trails.length > 0;
const trailCount = trails.length;

// Get first trail's difficulty
const firstTrailDifficulty = trails[0]?.difficulty || trails[0]?.stats?.difficulty || null;

// Some curated routes carry a verified guidebook distance while the only
// public-domain geometry available covers part of the route. Rather than
// silently drawing a short line as if it were the whole hike, say so — and
// give the numbers that ARE verified.
const primaryStats = trails[0]?.stats || {};
// route_length_mi is ONE traverse, so an out-and-back's geometry should be
// about half its hiked distance — comparing against the full figure would
// flag every healthy out-and-back as partial.
const expectedRouteLength = primaryStats.distance_type === 'loop'
  ? primaryStats.distance
  : primaryStats.distance / 2;
const partialRoute = primaryStats.distance_source === 'authored'
  && primaryStats.route_length_mi
  && primaryStats.distance
  && primaryStats.route_length_mi < expectedRouteLength * 0.7;

// Islands serialize their props into the HTML. TrailDashboard only reads
// these fields — passing the full mountain (seo schema, description HTML,
// page_content) roughly doubled trail-page weight (~300 KB of props).
const dashboardMountain = {
  name: mountain.name,
  lat: mountain.lat,
  lon: mountain.lon,
  trails: mountain.trails,
  trails_config: mountain.trails_config,
  nearby_peaks: mountain.nearby_peaks,
  current_conditions: mountain.current_conditions,
  user_reviews: mountain.user_reviews,
};
---

<Layout title={seo.meta_title || `${mountain.name} Trail Guide`} mountain={mountain}>
  <TrailSchema slot="head" mountain={mountain} />

  <main class="min-h-screen bg-stone-50">
    <!-- Hero Section -->
    <section class="hero relative h-[70vh] min-h-[500px] overflow-hidden">
      <div class="absolute inset-0">
        <img
          src={heroSrc}
          alt={heroAlt}
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>
        {!hasRealHero && (
          <div class="absolute bottom-2 right-3 text-[11px] text-white/60 bg-black/30 rounded px-2 py-0.5 z-10">
            Representative photo — not {mountain.name}
          </div>
        )}
        {mountain.hero_credit && (
          <a href={mountain.hero_credit.file} target="_blank" rel="noopener"
             class="absolute bottom-2 right-3 text-[11px] text-white/60 hover:text-white/90 bg-black/30 rounded px-2 py-0.5 z-10">
            {mountain.hero_credit.artist ? `© ${mountain.hero_credit.artist} · ` : ''}{mountain.hero_credit.license} · Wikimedia Commons
          </a>
        )}
      </div>

      <div class="relative h-full flex flex-col justify-end pb-12 px-4 md:px-8 max-w-7xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="mb-4" aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm text-white/70">
            <li><a href="/" class="hover:text-white">Home</a></li>
            <li>/</li>
            <li><a href={`/${mountain.state_slug}`} class="hover:text-white capitalize">{mountain.state || mountain.state_slug?.replace('-', ' ')}</a></li>
            <li>/</li>
            <li class="text-white font-medium">{mountain.name}</li>
          </ol>
        </nav>

        <!-- H1 Title -->
        <h1 class="text-4xl md:text-6xl font-bold text-white mb-4">
          {mountain.name}
        </h1>

        <p class="text-xl text-white/90 mb-6">
          {mountain.elevation?.toLocaleString()} ft | {trailCount} trails | {mountain.state || mountain.state_slug?.replace('-', ' ')}
        </p>

        <!-- Quick Stats -->
        <div class="flex flex-wrap gap-4">
          <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2">
            <span class="text-white/70 text-sm">Elevation</span>
            <p class="text-white font-bold">{mountain.elevation?.toLocaleString()} ft</p>
          </div>

          <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2">
            <span class="text-white/70 text-sm">Trails</span>
            <p class="text-white font-bold">{trailCount} routes</p>
          </div>

          {firstTrailDifficulty && (
            <div class="bg-white/20 backdrop-blur-sm rounded-lg px-4 py-2">
              <span class="text-white/70 text-sm">Difficulty</span>
              <p class="text-white font-bold">{firstTrailDifficulty}</p>
            </div>
          )}

          {mountain.tags?.includes('4000 Footer') && (
            <div class="bg-emerald-500/90 backdrop-blur-sm rounded-lg px-4 py-2">
              <span class="text-white/90 text-sm">Peak List</span>
              <p class="text-white font-bold">NH 4000-Footer</p>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Main Content Area -->
    <div class="max-w-7xl mx-auto px-4 md:px-8 py-8">

      <!-- Peak-bagging tracker (localStorage, powers /my-peaks) -->
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <SavePeakButton
          client:load
          slug={mountain.slug}
          name={mountain.name}
          stateSlug={mountain.state_slug}
          stateName={mountain.state}
          elevation={mountain.elevation}
        />
        {hasHighestPeaksPage && (
          <a href={`/${mountain.state_slug}/highest-peaks`}
             class="text-sm font-semibold text-emerald-700 hover:text-emerald-800 hover:underline">
            Highest peaks in {mountain.state || mountain.state_slug?.replace(/-/g, ' ')} →
          </a>
        )}
      </div>

      <!-- Trail Dashboard - Shows when trail data exists (either trails or trails_config) -->
      {hasTrails && (
        <section class="mt-8 relative z-10 mb-12" id="trails">
          {partialRoute && (
            <div class="mb-4 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 p-4">
              <svg class="mt-0.5 h-5 w-5 flex-shrink-0 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
              <p class="text-sm text-amber-900">
                <strong>Partial route shown.</strong> The {primaryStats.distance} mi
                distance and {primaryStats.gain?.toLocaleString()} ft of gain for this hike are
                verified, but public trail data currently maps only part of the
                route — the line below is incomplete. Carry an official map and
                don't navigate from this track alone.
              </p>
            </div>
          )}
          <TrailDashboard
            client:only="react"
            mountain={dashboardMountain}
          />
        </section>
      )}

      <!-- Fallback when no trail data at all -->
      {!hasTrails && (
        <section class="-mt-24 relative z-10 mb-12 bg-white rounded-2xl shadow-xl p-8">
          <div class="text-center py-8">
            <svg class="w-16 h-16 mx-auto text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            <h2 class="text-2xl font-bold text-stone-900 mb-2">Trail Maps Coming Soon</h2>
            <p class="text-stone-600 max-w-md mx-auto">
              We're working on detailed trail maps for {mountain.name}.
              Check back soon for interactive routes and elevation profiles.
            </p>
          </div>

          <!-- Basic Info Grid -->
          <div class="mt-8 grid md:grid-cols-2 gap-6">
            <div class="bg-stone-50 rounded-xl p-6">
              <h3 class="font-bold text-stone-900 mb-4">Summit Information</h3>
              <dl class="space-y-3">
                <div class="flex justify-between">
                  <dt class="text-stone-500">Elevation</dt>
                  <dd class="font-bold">{mountain.elevation?.toLocaleString()} ft</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-stone-500">Coordinates</dt>
                  <dd class="font-mono text-sm">{mountain.lat?.toFixed(4)}, {mountain.lon?.toFixed(4)}</dd>
                </div>
                <div class="flex justify-between">
                  <dt class="text-stone-500">State</dt>
                  <dd class="font-bold capitalize">{mountain.state || mountain.state_slug?.replace('-', ' ')}</dd>
                </div>
              </dl>
            </div>

            <!-- Weather Widget -->
            <div>
              <WeatherWidget
                client:only="react"
                lat={mountain.lat}
                lon={mountain.lon}
                elevation={mountain.elevation}
              />
            </div>
          </div>
        </section>
      )}

      <!-- Additional Content -->
      <div class="space-y-8 mt-8">

        <!-- Description -->
        {mountain.generated_description && (
          <section class="bg-white rounded-xl p-6 border border-stone-200" id="about">
            <h2 class="text-2xl font-bold text-stone-900 mb-4">About {mountain.name}</h2>
            <div class="prose prose-stone max-w-none" set:html={mountain.generated_description} />
          </section>
        )}

        <!-- User Reviews - Using fixed component -->
        <SocialPulse
          userReviews={mountain.user_reviews}
          mountainName={mountain.name}
        />

        <!-- FAQ Section -->
        <FAQSection faqs={pageContent.faqs} mountainName={mountain.name} />

        <!-- Seasonal Guide -->
        <SeasonalGuide seasons={pageContent.seasonal_guide} elevation={mountain.elevation} />

        <!-- Safety Section -->
        <SafetySection safety={pageContent.safety} mountainName={mountain.name} elevation={mountain.elevation} lat={mountain.lat} lon={mountain.lon} />

        <!-- Downloads -->
        <div class="bg-white rounded-xl border border-stone-200 p-6">
          <DownloadsSection mountain={mountain} downloads={engagement.downloads} />
        </div>
      </div>

      <!-- Nearby Peaks -->
      {mountain.nearby_peaks && mountain.nearby_peaks.length > 0 && (
        <NearbyPeaksAstro
          peaks={mountain.nearby_peaks}
          currentMountain={mountain.name}
          stateSlug={mountain.state_slug}
        />
      )}

      <!-- Keep Exploring: hub-and-spoke internal links -->
      {(relatedTrails.length > 0 || cityLink) && (
        <section class="mt-12" aria-label="Related trails">
          <h2 class="text-2xl font-bold text-stone-900 mb-6">Keep Exploring</h2>
          {relatedTrails.length > 0 && (
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
              {relatedTrails.map(t => (
                <a href={`/${t.state_slug}/hikes/${t.slug}`}
                   class="block bg-white border border-stone-200 rounded-xl p-4 hover:border-emerald-400 hover:shadow-md transition-all">
                  <p class="font-bold text-stone-900 mb-1">{t.name}</p>
                  <p class="text-sm text-stone-500">
                    {t.elevation ? `${t.elevation.toLocaleString()} ft` : ''}
                    {t.distance ? ` · ${t.distance} mi` : ''}
                    {t.difficulty ? ` · ${t.difficulty}` : ''}
                  </p>
                </a>
              ))}
            </div>
          )}
          <div class="flex flex-wrap gap-3">
            {myDifficulty && (
              <a href={`/${mountain.state_slug}/hikes/${myDifficulty.toLowerCase().trim().replace(/\s+/g, '-').replace(/s$/, '')}`}
                 class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-4 py-2 hover:bg-emerald-100 transition-colors">
                More {myDifficulty} hikes in {mountain.state || mountain.state_slug?.replace(/-/g, ' ')} →
              </a>
            )}
            {cityLink && (
              <a href={`/near/${cityLink.slug}`}
                 class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-4 py-2 hover:bg-emerald-100 transition-colors">
                Hikes near {cityLink.name} →
              </a>
            )}
            <a href={`/${mountain.state_slug}`}
               class="inline-flex items-center gap-1 text-sm font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-full px-4 py-2 hover:bg-emerald-100 transition-colors">
              All {mountain.state || mountain.state_slug?.replace(/-/g, ' ')} trails →
            </a>
          </div>
        </section>
      )}
    </div>

    <!-- Footer -->
    <SiteFooter />
  </main>
</Layout>