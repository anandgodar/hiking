---
/**
 * Best Hikes Near Trenton, New Jersey
 * High-value SEO landing page targeting "hikes near trenton nj"
 *
 * title: Best Hikes Near Trenton, NJ 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Trenton, New Jersey — from Baldpate Mountain
 *   and the NJ Highlands to the state's own High Point and New York's Hudson Highlands, with real
 *   drive times, maps and difficulty ratings for every trail.
 * slug: trenton
 * date: 2026-09-01
 * targetKeywords: hikes near trenton nj, hiking trails near trenton new jersey, best hikes near
 *   trenton
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Trenton New Jersey" surfaces onX, AllTrails, Gaia GPS, Yelp,
 *   Komoot and onlyinyourstate.com, all pointing at isolated local parkland and preserves (Mercer
 *   County Park, the Mercer County Baldpate Mountain in Ted Stiles Preserve, Washington Crossing
 *   State Park, Mountain Lakes Nature Preserve, the Delaware Canal towpath) with no drive-time
 *   computation and no sense of the wider ridge system north of the city. CORRECTION (caught by a
 *   Codex review same-day, fixed in this same-day follow-up): this site's own trail database has a
 *   different, separate "Baldpate Mountain" — a real 1,165ft NJ Highlands summit near West Milford,
 *   not the low Mercer County hill in Ted Stiles Preserve that competitors mean — so the page no
 *   longer claims they're the same peak; it stands on its own as this database's closest tracked
 *   summit. Nobody covers the wider NJ Highlands/Kittatinny system that runs north through Jenny
 *   Jump, Schooleys Mountain and Wawayanda to the state's own High Point. Trenton isn't in
 *   cities.json (no programmatic page exists) and wasn't hand-authored before this page. The data
 *   backs it: 28 publish-ready trails within 100 miles, the database's own Baldpate Mountain at 41
 *   miles/54 minutes anchoring the close-in cluster, and the farthest tier reaching New Jersey's
 *   own High Point plus Bear Mountain and Anthony's Nose in New York's Hudson Highlands.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Trenton, NJ coordinates
const trentonLat = 40.2171;
const trentonLon = -74.7429;

// Calculate distance from Trenton
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - trentonLat) * Math.PI / 180;
  const dLon = (lon - trentonLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(trentonLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Trenton and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// The farthest tier is the actual differentiator here — New Jersey's own
// High Point plus Bear Mountain and Anthony's Nose in New York's Hudson
// Highlands — so this deliberately takes the farthest 8 rather than the
// nearest 8 beyond 50mi, same deviation as Worcester/Springfield's Greylock
// anchor and Scranton & Wilkes-Barre's Catskills/Hudson Highlands anchor,
// and for the same reason: a plain slice(0, 8) here would return only the
// closer central-NJ Highlands summits and miss every peak this page's own
// copy leans on.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(-8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const highPoint = nearbyHikes.find(h => h.name === 'High Point');
const bearMountain = nearbyHikes.find(h => h.name === 'Bear Mountain');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Trenton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail to Trenton is ${closestHikes[0]?.name}, roughly ${Math.round(closestHikes[0]?.distance)} miles (${closestHikes[0]?.driveTime} minutes) away at the southern end of the NJ Highlands.`
      }
    },
    {
      "@type": "Question",
      "name": "Which Baldpate Mountain is closest to Trenton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "There are two New Jersey summits with this name. The one many local guides mean is a low hill in Mercer County's Ted Stiles Preserve, close to downtown Trenton but not part of this guide's named-summit database. The one on this page is a different, real 1,165-foot peak in the NJ Highlands near West Milford — the closest tracked trail at about 41 miles and a 54-minute drive, and the southern entry point to a much longer system that runs north through Jenny Jump, Schooleys Mountain and Wawayanda to the state's own high point, all within a two-hour drive of Trenton."
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Trenton, NJ?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — while downtown Trenton itself sits low along the Delaware River, the NJ Highlands begin less than an hour north and run the length of the state's northwestern corner. The system tops out at High Point, New Jersey's own state high point at 1,803 feet, roughly 77 miles and just over 100 minutes from Trenton."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Trenton for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Several of the closest NJ Highlands summits — Baldpate Mountain, Mount No More and County House Mountain among them — are shorter, lower-elevation routes well suited to beginners, most under an hour from Trenton with well-marked trails."
      }
    },
    {
      "@type": "Question",
      "name": "How far is the Hudson Highlands from Trenton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Bear Mountain, in New York's Hudson Highlands, is roughly ${bearMountain ? `${Math.round(bearMountain.distance)} miles (${bearMountain.driveTime} minutes)` : '85 miles'} from Trenton — the farthest reasonable day trip on this guide, and a genuine summit rather than a local preserve.`
      }
    }
  ]
};

// LocalBusiness Schema for Trenton area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Trenton - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Trenton, New Jersey",
  "url": "https://summitseeker.io/near/trenton",
  "areaServed": {
    "@type": "City",
    "name": "Trenton",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Trenton",
      "addressRegion": "NJ",
      "addressCountry": "US"
    }
  }
};
---

<Layout
