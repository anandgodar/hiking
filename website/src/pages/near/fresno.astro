---
/**
 * Best Hikes Near Fresno, California
 * High-value SEO landing page targeting "hikes near fresno"
 *
 * title: Best Hikes Near Fresno, CA 2026 | Yosemite Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Fresno, California — Yosemite Valley's
 *   biggest names (Half Dome, the Mist Trail, Yosemite Falls) and the high Sierra beyond,
 *   with real drive times, maps and difficulty ratings for every trail.
 * slug: fresno
 * date: 2026-09-07
 * targetKeywords: hikes near fresno, best hikes near fresno ca, fresno yosemite hiking trails,
 *   best hikes near fresno yosemite sierra nevada
 * targetSite: summitseeker.io
 * competitorGap: "best hikes near Fresno Yosemite Sierra Nevada" and the general "best hiking
 *   trails near me" query both surface visitfresnocounty.org (a county tourism board "staff
 *   picks" post), komoot, cassiescompass.com, bestthingsandplaces.com and
 *   flyingdawnmarie.com's Fresno Dome writeup — all pointing at either in-county spots (Hume
 *   Lake, Fresno Dome) or a flat list of national-park names (Half Dome, Mirror Lake, Mariposa
 *   Grove, Moro Rock, Zumwalt Meadow), with no drive-time computation from real trailhead
 *   coordinates and no systematic distance/difficulty sort. Fresno isn't in cities.json (no
 *   programmatic page) and wasn't hand-authored before this page. The data backs it, but
 *   narrowly: this site's database has no named-summit coverage of Sequoia or Kings Canyon,
 *   and only 9 publish-ready trails fall within a real 2-hour drive of Fresno — Yosemite
 *   Valley's actual marquee trails (Half Dome, all three of the Valley's major waterfalls via
 *   the Mist Trail), all within roughly 90-95 minutes via Highway 41.
 * driveTimeNote: a Codex review on the merged PR #79 correctly flagged that dividing haversine
 *   distance by 45mph cannot produce a real drive time, and specifically that this let Mount
 *   Whitney and the Tuolumne Meadows high country (Cathedral Lakes, Clouds Rest, May Lake) into
 *   a page advertised as "within 2 hours." Mount Whitney (~86mi as the crow flies, no through
 *   road across the Sierra crest at this latitude — a real 3.5+ hour drive around the range)
 *   was already excluded in the merged version; this follow-up applies the same fix to the
 *   Tuolumne cluster, reached from Fresno via Tioga Road (Hwy 120) past the Valley — a real
 *   3+ hour drive, not the ~103-105 minutes the formula produced. Both are now excluded from
 *   the trail list, the trail count, and every nearest-city chip/link that could point at this
 *   page, and covered honestly in the FAQ instead of with a fabricated drive time.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Fresno, CA coordinates
const fresnoLat = 36.7378;
const fresnoLon = -119.7871;

// Calculate distance from Fresno
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - fresnoLat) * Math.PI / 180;
  const dLon = (lon - fresnoLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(fresnoLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Fresno and sort by distance
const nearbyHikesRaw = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Mount Whitney clears the filter above (~86mi / ~115min as the crow flies)
// but there is no through road across the Sierra Nevada crest at this
// latitude — reaching the Whitney Portal trailhead near Lone Pine actually
// means driving around the range (via Bakersfield, or north through
// Yosemite's seasonal Tioga Pass to US-395), a 3.5+ hour trip either way.
// That's not the ordinary haversine-vs-real-road slop this site's other
// /near/ pages already accept (a rounding error of a few minutes) — it's
// off by multiples, so it's excluded here rather than shown with a
// fabricated drive time.
//
// A Codex review on the merged PR that shipped this page caught the same
// problem one tier down: Cathedral Lakes, Clouds Rest and May Lake all sit
// in Tuolumne Meadows, reached from Fresno via Tioga Road (Hwy 120) well
// past the Valley — a real 3+ hour drive on a winding mountain road, not
// the ~103-105 minutes 45mph-flat-road math produces. Same fix as Whitney:
// excluded from the list and the count, addressed honestly in the FAQ.
const excludedNames = new Set(['Mount Whitney', 'Cathedral Lakes', 'Clouds Rest', 'May Lake']);
const nearbyHikes = nearbyHikesRaw.filter(m => !excludedNames.has(m.name));
const findExcluded = (name) => nearbyHikesRaw.find(h => h.name === name);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// Fresno's real differentiator isn't a farther-tier city (nothing named this
// site tracks sits meaningfully beyond Yosemite's own high country) — it's
// the jump in difficulty: the strenuous all-day summits and the tallest
// waterfall route, the trails a "best hikes near Fresno" searcher actually
// means when they ask for something more than a valley-floor walk.
const strenuousHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('strenuous');
}).slice(0, 8);

// Normalize state slug (data already stores full slugs for these states,
// this only covers the abbreviated ones used elsewhere on the site)
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const halfDome = nearbyHikes.find(h => h.name === 'Half Dome');
// Both excluded from nearbyHikes above (unreliable drive-time math for this
// cluster) — looked up from the raw list only for their real distance, used
// below to describe them honestly rather than with a fabricated drive time.
const cloudsRest = findExcluded('Clouds Rest');
const cathedralLakes = findExcluded('Cathedral Lakes');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Fresno, CA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail to Fresno is ${closestHikes[0]?.name}, roughly ${Math.round(closestHikes[0]?.distance)} miles (${closestHikes[0]?.driveTime} minutes) away in Yosemite Valley via Highway 41.`
      }
    },
    {
      "@type": "Question",
      "name": "How far is Half Dome from Fresno?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Half Dome is roughly ${halfDome ? `${Math.round(halfDome.distance)} miles (${halfDome.driveTime} minutes)` : '70 miles (93 minutes)'} from Fresno, making it a genuine (if long) day trip — though the cable route requires an advance permit.`
      }
    },
    {
      "@type": "Question",
      "name": "How far is Yosemite Valley from Fresno?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yosemite Valley is about 70 miles from Fresno via Highway 41 (the Wawona Road), roughly a 90-minute drive in clear conditions — longer in summer traffic or winter snow. It's the closest entrance to Fresno of any of Yosemite's gates."
      }
    },
    {
      "@type": "Question",
      "name": "Is Mount Whitney a day trip from Fresno?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not really, despite being only about 86 miles away as the crow flies. Mount Whitney sits on the opposite side of the Sierra Nevada crest, and there's no through road at this latitude — reaching the Whitney Portal trailhead near Lone Pine means driving around the range, either south via Bakersfield or north through Yosemite's seasonal Tioga Pass to US-395. Either route is 3.5+ hours, so it isn't included in the trail list above."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Tuolumne Meadows (Cathedral Lakes, Clouds Rest) from Fresno?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Farther than the Valley floor trails above, and not a same-day quick trip. Cathedral Lakes${cathedralLakes ? ` (${Math.round(cathedralLakes.distance)} miles as the crow flies)` : ''} and Clouds Rest${cloudsRest ? ` (${Math.round(cloudsRest.distance)} miles)` : ''} sit in Tuolumne Meadows, reached from Fresno via Highway 41 through the Valley and then Tioga Road (Hwy 120) — real driving time is 3+ hours each way on a winding mountain road, not a straight-line estimate. Tioga Road is also closed by snow every winter, typically reopening late May or June and closing again by early-to-mid November. Worth a full day or an overnight, not a quick add-on to a Valley visit.`
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Fresno for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${easyHikes[0]?.name}, ${easyHikes[1]?.name} and ${easyHikes[2]?.name} are all rated easy, paved or near-flat, and sit right in Yosemite Valley — no permit or technical gear needed for any of them.`
      }
    }
  ]
};

// LocalBusiness Schema for Fresno area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Fresno - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Fresno, California, including Yosemite Valley and the high Sierra",
  "url": "https://summitseeker.io/near/fresno",
  "areaServed": {
    "@type": "City",
    "name": "Fresno",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Fresno",
      "addressRegion": "CA",
      "addressCountry": "US"
    }
  }
};
---

<Layout
  title="Best Hikes Near Fresno, CA 2026 | Yosemite Trails Within 2 Hours (With Drive Times)"
  description="Discover the best hiking trails near Fresno, California — Yosemite Valley's biggest names (Half Dome, the Mist Trail, Yosemite Falls) and the high Sierra beyond, with real drive times, maps and difficulty ratings for every trail."
>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <!-- Hero Section -->
  <div class="relative h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden">
