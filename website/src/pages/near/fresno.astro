          </div>
        </section>
      )}

      <!-- Easy Hikes Section -->
      {easyHikes.length > 0 && (
        <section id="easy" class="mb-16">
          <div class="flex items-center gap-4 mb-8">
            <div class="bg-emerald-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">🥾</div>
            <div>
              <h2 class="text-3xl font-bold text-stone-900">Best Easy Hikes Near Fresno</h2>
              <p class="text-stone-600">Valley-floor trails, paved or near-flat, no permit required</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {easyHikes.map(mountain => (
              <div class="relative">
                <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
                <div class="absolute top-4 right-4 bg-emerald-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                  EASY
                </div>
              </div>
            ))}
          </div>
        </section>
