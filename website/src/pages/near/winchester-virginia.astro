---
/**
 * Best Hikes Near Winchester, Virginia
 * High-value SEO landing page targeting "hikes near winchester va"
 *
 * title: Best Hikes Near Winchester, VA 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Winchester, Virginia — from western
 *   Maryland's Allegheny Highlands to two state high points and West Virginia's Eastern
 *   Highlands, with real drive times, maps and difficulty ratings for every trail.
 * slug: winchester-virginia
 * date: 2026-09-02
 * targetKeywords: hikes near winchester va, hiking trails near winchester virginia, best hikes
 *   near winchester virginia shenandoah valley
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Winchester Virginia" and "best hikes near Winchester Virginia
 *   Shenandoah Valley" surface AllTrails, onX, Komoot, gohikevirginia.com, visitwinchesterva.com,
 *   dreamweaverteam.com and womanswalk.net, every one pointing at in-city or near-city spots (the
 *   Museum of the Shenandoah Valley Loop Trail, the Winchester Green Circle Trail, Blandy
 *   Experimental Farm) or AT/Tuscarora/Massanutten trailhead access points — none of it the
 *   named-summit trails this site's database tracks, and none computing real drive times. Nobody
 *   mentions that Winchester sits within a 90-minute drive of two separate state high points —
 *   Pennsylvania's own Mount Davis and Maryland's own Hoye-Crest — or that West Virginia's Eastern
 *   Highlands (Canaan Valley/Dolly Sods country: Canaan Mountain, Cabin Mountain, Snowy Mountain,
 *   Fork Mountain) are in the same day-trip window. Winchester isn't in cities.json (no
 *   programmatic page exists) and wasn't hand-authored before this page. The data backs it: 48
 *   publish-ready trails within 100 miles/120 minutes, the western Maryland Allegheny cluster
 *   (Dans Rock, Wolf Rock, Fairview) anchoring the close-in tier at 50 miles/66 minutes, and the
 *   farthest tier reaching both state high points plus West Virginia's 4,000+ft Eastern Highlands.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Winchester, VA coordinates
const winchesterLat = 39.1857;
const winchesterLon = -78.1633;

// Calculate distance from Winchester
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - winchesterLat) * Math.PI / 180;
  const dLon = (lon - winchesterLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(winchesterLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Winchester and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// The farthest tier is the actual differentiator here — West Virginia's
// Eastern Highlands plus Pennsylvania's Mount Davis and Maryland's
// Hoye-Crest — so this deliberately takes the farthest 8 rather than the
// nearest 8 beyond 50mi, same deviation as Trenton, Worcester/Springfield
// and Scranton/Wilkes-Barre, and for the same reason: a plain slice(0, 8)
// here would return only the closer western-Maryland Allegheny summits and
// miss every peak this page's own copy leans on.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(-8);

// Normalize state slug (data already stores full slugs for these states,
// this only covers the abbreviated ones used elsewhere on the site)
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const mountDavis = nearbyHikes.find(h => h.name === 'Mount Davis');
const hoyeCrest = nearbyHikes.find(h => h.name === 'Hoye-Crest');
const canaanMountain = nearbyHikes.find(h => h.name === 'Canaan Mountain');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Winchester, VA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail to Winchester is ${closestHikes[0]?.name}, roughly ${Math.round(closestHikes[0]?.distance)} miles (${closestHikes[0]?.driveTime} minutes) away in western Maryland's Allegheny Highlands.`
      }
    },
    {
      "@type": "Question",
      "name": "How far is Mount Davis, Pennsylvania's state high point, from Winchester?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Mount Davis is roughly ${mountDavis ? `${Math.round(mountDavis.distance)} miles (${mountDavis.driveTime} minutes)` : '68 miles (90 minutes)'} from Winchester — Pennsylvania's own state high point, reachable well within a two-hour drive.`
      }
    },
    {
      "@type": "Question",
      "name": "How far is Hoye-Crest, Maryland's state high point, from Winchester?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Hoye-Crest is roughly ${hoyeCrest ? `${Math.round(hoyeCrest.distance)} miles (${hoyeCrest.driveTime} minutes)` : '69 miles (92 minutes)'} from Winchester — Maryland's own state high point, on Backbone Mountain near the West Virginia line. Winchester is one of the few cities within day-trip range of two separate state high points.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Winchester, VA?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — while Winchester itself sits in the Shenandoah Valley with mostly local parkland close in, western Maryland's Allegheny Highlands begin under an hour west, and West Virginia's Eastern Highlands (the Canaan Valley/Dolly Sods high country, several summits over 4,000 feet) are within about 90 to 120 minutes."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Winchester for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Several of the closer western Maryland summits — Dans Rock, Fairview and Wolf Rock among them — are shorter, well-marked routes suited to beginners, most within a 70-minute drive of Winchester."
      }
    },
    {
      "@type": "Question",
      "name": "How far is West Virginia's Canaan Valley high country from Winchester?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Canaan Mountain, in West Virginia's Canaan Valley/Dolly Sods high country, is roughly ${canaanMountain ? `${Math.round(canaanMountain.distance)} miles (${canaanMountain.driveTime} minutes)` : '67 miles (89 minutes)'} from Winchester — real 4,000-plus-foot elevation, a different character from the lower Allegheny cluster closer in.`
      }
    }
  ]
};

// LocalBusiness Schema for Winchester area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Winchester - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Winchester, Virginia",
  "url": "https://summitseeker.io/near/winchester-virginia",
  "areaServed": {
    "@type": "City",
    "name": "Winchester",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Winchester",
      "addressRegion": "VA",
      "addressCountry": "US"
    }
  }
};
---

