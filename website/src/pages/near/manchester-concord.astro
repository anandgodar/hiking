---
/**
 * Best Hikes Near Manchester & Concord, New Hampshire
 * High-value SEO landing page targeting "hikes near manchester nh" and
 * "hiking trails near concord nh"
 *
 * title: Best Hikes Near Manchester & Concord, NH 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Manchester and Concord, New Hampshire —
 *   from the close-in Lakes Region cluster to Mount Washington and the Presidential Range,
 *   with real drive times, maps and difficulty ratings for every trail.
 * slug: manchester-concord
 * date: 2026-08-27
 * targetKeywords: hikes near manchester nh, hiking trails near concord nh, best hikes near manchester nh
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Manchester, New Hampshire" and "best hiking trails near Concord,
 *   New Hampshire" surface onX, AllTrails, Gaia GPS, Yelp, theoutbound.com, komoot, threebestrated.com,
 *   letsgoplayoutside.com and a Yogi Bear's Jellystone Park (Milton, NH) blog post — all pointing at
 *   in-county trails (Tower Hill Pond, the Uncanoonuc peaks, Lake Massabesic, Bear Brook State Park,
 *   Oak Hill Fire Tower, Pulpit Rock, Winant Park) or general AMC/rail-trail roundups. None of them
 *   compute real drive times from trailhead coordinates, and none mention that Manchester and
 *   Concord — unlike every southern-New-England city already shipped on this site — sit close
 *   enough to New Hampshire's own White Mountains that Mount Washington and the Presidential Range
 *   are reachable in under 100 minutes, closer than from any other /near/ city on this site. This
 *   brief predates the confirmed 9-city Northeast queue (it was twice checked off as "shipped" in
 *   past runs with no file or PR ever landing — see content board), but is a strong candidate on its
 *   own merits: home turf, 56 NH trail guides already in the database, and a real competitive gap.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Manchester and Concord, NH coordinates
const manchesterLat = 42.9956;
const manchesterLon = -71.4548;
const concordLat = 43.2081;
const concordLon = -71.5376;

// Haversine distance in miles
const calculateDistance = (lat1, lon1, lat2, lon2) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Two starting cities, not one — each trail is scored against whichever of
// Manchester or Concord it's actually closer to, and that city's name
// travels with it through the page. Same min-distance-of-two-cities rule as
// Worcester/Springfield, applied up front here rather than waiting for a
// chip-count mismatch to surface it later.
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    const distManchester = calculateDistance(manchesterLat, manchesterLon, thLat, thLon);
    const distConcord = calculateDistance(concordLat, concordLon, thLat, thLon);
    const nearerCity = distManchester <= distConcord ? 'Manchester' : 'Concord';
    const distance = Math.min(distManchester, distConcord);
    return {
      ...m,
      distance,
      nearerCity,
      driveTime: Math.round(distance / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// Nearest 8 beyond 50mi, not the farthest 8 by raw distance — a plain
// slice(-8) here pulls in Rhode Island and Vermont/Maine hills that happen
// to sit right at the edge of the 100mi/120min radius (a side effect of the
// two-city min-distance rule) and excludes Mount Washington and most of the
// Presidential Range, even though those are this page's actual differentiator.
// slice(0, 8) instead lands on the near end of the White Mountains cluster
// (Tecumseh, Passaconaway, the Tripyramids, Chocorua, Osceola, Moosilauke),
// matching what this section's own copy promises.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(0, 8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const washington = nearbyHikes.find(h => h.slug === 'mount-washington-nh');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Manchester or Concord, NH?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail is ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes from ${closestHikes[0]?.nearerCity}), part of New Hampshire's own Lakes Region cluster.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Manchester and Concord, New Hampshire?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — unlike most southern New England cities, Manchester and Concord sit inside New Hampshire itself. Mount Kearsarge and Mount Major offer real close-in summits within about 30 minutes, and the true White Mountains, including Mount Washington, are under two hours north."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Mount Washington from Manchester and Concord?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": washington
          ? `Mount Washington is roughly ${Math.round(washington.distance)} miles from ${washington.nearerCity}, about a ${washington.driveTime}-minute drive north on I-93 and Route 302 — closer than from any other major New England city.`
          : "Mount Washington is roughly 74 miles from Concord, about a 98-minute drive north on I-93 and Route 302 — closer than from any other major New England city."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Manchester and Concord for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mount Wachusett across the Massachusetts line and Mount Agamenticus near the Maine coast are both gentle, well-marked options within about an hour, alongside lower-elevation trails in New Hampshire's own Lakes Region closer to home."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need a parking pass for hiking trails near Manchester or Concord?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Most New Hampshire state park trailheads charge a day-use parking fee, including popular Lakes Region spots and the White Mountain National Forest, which requires a White Mountain National Forest parking pass at most trailheads. Free options are more common at town conservation land close to Manchester and Concord themselves."
      }
    }
  ]
};

// LocalBusiness Schema for Manchester/Concord area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Manchester & Concord - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Manchester and Concord, New Hampshire",
  "url": "https://summitseeker.io/near/manchester-concord",
  "areaServed": [
    {
      "@type": "City",
      "name": "Manchester",
      "address": { "@type": "PostalAddress", "addressLocality": "Manchester", "addressRegion": "NH", "addressCountry": "US" }
    },
    {
      "@type": "City",
      "name": "Concord",
      "address": { "@type": "PostalAddress", "addressLocality": "Concord", "addressRegion": "NH", "addressCountry": "US" }
    }
  ]
};
