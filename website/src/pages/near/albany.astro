---
/**
 * Best Hikes Near Albany, New York
 * High-value SEO landing page targeting "hikes near albany ny"
 *
 * slug: albany
 * date: 2026-08-25
 * targetKeywords: hikes near albany ny, hiking trails near albany new york, best hikes near albany
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Albany NY" surfaces AllTrails, the Albany.org and Albany.com
 *   tourism-site listicles, a Bethlehem Public Library blog post and a Quora thread — general
 *   trail-finder and local-interest content, not a database with drive-time context or real
 *   trailhead data. Adventures Atlas (a personal Upstate NY hiking blog) covers the region well
 *   editorially but isn't built around distance sorting. This page pairs Albany with the southern
 *   Berkshires cluster it actually sits closest to (many under 35 minutes) plus the Catskills'
 *   Hunter and Slide mountains and southern Vermont as farther day trips, all computed from real
 *   trailhead coordinates rather than estimated.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Albany, NY coordinates
const albanyLat = 42.6526;
const albanyLon = -73.7562;

// Calculate distance from Albany
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - albanyLat) * Math.PI / 180;
  const dLon = (lon - albanyLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(albanyLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Albany and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(0, 8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Albany?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trails to Albany are ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes) and ${closestHikes[1]?.name} (${Math.round(closestHikes[1]?.distance)} miles, ${closestHikes[1]?.driveTime} minutes), both in the southern Berkshires cluster just across the Massachusetts line to the east.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Albany, NY?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — Albany sits at the meeting point of three highland regions. The southern Berkshires of Massachusetts are the closest, many under 35 minutes east. The Catskills, with Hunter Mountain and Slide Mountain (the range's high point at 4,180 feet), lie roughly 40 to 55 miles south. Southern Vermont's Green Mountains, including Stratton and Killington, are the farthest of the three but still within a two-hour drive northeast."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Albany for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The southern Berkshires cluster closest to Albany includes several shorter, lower-elevation routes well suited to beginners, most under 45 minutes with clearly marked trails and modest elevation gain."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Slide Mountain, the Catskills' high point, from Albany?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Slide Mountain, at 4,180 feet the highest peak in the Catskills, is roughly 53 miles from Albany — about a 70-minute drive south. It's the biggest single-peak day trip in range for Albany-area hikers looking for real elevation."
      }
    }
  ]
};

// LocalBusiness Schema for Albany area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Albany - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Albany, New York",
  "url": "https://summitseeker.io/near/albany",
  "areaServed": {
    "@type": "City",
    "name": "Albany",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Albany",
      "addressRegion": "NY",
      "addressCountry": "US"
    }
  }
};
---

