---
/**
 * Best Hikes Near Scranton & Wilkes-Barre, Pennsylvania
 * High-value SEO landing page targeting "hikes near scranton pa" and
 * "hiking trails near wilkes-barre pa"
 *
 * title: Best Hikes Near Scranton & Wilkes-Barre, PA 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Scranton and Wilkes-Barre, Pennsylvania —
 *   from New Jersey's Kittatinny Ridge to New York's Catskill high peaks and Hudson Highlands,
 *   with real drive times, maps and difficulty ratings for every trail.
 * slug: scranton-wilkes-barre
 * date: 2026-08-29
 * targetKeywords: hikes near scranton pa, hiking trails near wilkes-barre pa, best hikes near
 *   scranton wilkes-barre poconos
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Scranton Wilkes-Barre Pennsylvania Poconos" surfaces
 *   theoutbound.com, AllTrails, Yelp, discovernepa.com and a Keystone Newsroom "ranked" listicle —
 *   all pointing at local state parks and waterfall walks (Ricketts Glen's Falls Trail, Hickory
 *   Run's Hawk Falls, Nay Aug Park, the Pinchot Trail, Bear Creek Preserve, the Lake Scranton
 *   loop). None of them are named-summit hikes this site's database tracks, none compute real
 *   drive times, and none mention that Scranton/Wilkes-Barre sits within striking distance of two
 *   distinct real-elevation regions in opposite directions: New Jersey's Kittatinny Ridge
 *   (Mount Tammany, High Point) under an hour east, and New York's Catskill high peaks (Slide
 *   and Wittenberg, the range's two tallest summits) plus the Hudson Highlands (Bear Mountain,
 *   Breakneck Ridge) within two hours north and east. Scranton and Wilkes-Barre aren't in
 *   cities.json (no programmatic page) and weren't hand-authored before this page. The data
 *   backs it: 30 publish-ready trails within 100 miles/120 minutes, Mount Tammany at 41
 *   miles/55 minutes anchoring the close tier, Slide Mountain (the Catskills' own high point) at
 *   77 miles/103 minutes anchoring the farthest tier.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Scranton and Wilkes-Barre, PA coordinates
const scrantonLat = 41.4090;
const scrantonLon = -75.6624;
const wilkesBarreLat = 41.2459;
const wilkesBarreLon = -75.8813;

// Haversine distance in miles
const calculateDistance = (lat1, lon1, lat2, lon2) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Two starting cities, not one — each trail is scored against whichever of
// Scranton or Wilkes-Barre it's actually closer to, and that city's name
// travels with it through the page. Same min-distance-of-two-cities rule as
// Worcester/Springfield and Manchester/Concord, applied up front here rather
// than waiting for a chip-count mismatch to surface it later.
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    const distScranton = calculateDistance(scrantonLat, scrantonLon, thLat, thLon);
    const distWilkesBarre = calculateDistance(wilkesBarreLat, wilkesBarreLon, thLat, thLon);
    const nearerCity = distScranton <= distWilkesBarre ? 'Scranton' : 'Wilkes-Barre';
    const distance = Math.min(distScranton, distWilkesBarre);
    return {
      ...m,
      distance,
      nearerCity,
      driveTime: Math.round(distance / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// Nearest 8 beyond 50mi, not the farthest 8 by raw distance — same fix as
// Manchester/Concord: a plain slice(-8) would pull in whatever happens to sit
// at the outer edge of the radius rather than the Catskills/Hudson Highlands
// cluster this section's own copy promises.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(0, 8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const slide = nearbyHikes.find(h => h.slug === 'slide-mountain-catskills-ny');
const tammany = nearbyHikes.find(h => h.slug === 'mount-tammany-nj');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Scranton or Wilkes-Barre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest named-summit trail is ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes from ${closestHikes[0]?.nearerCity}), on New Jersey's Kittatinny Ridge.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Scranton and Wilkes-Barre, Pennsylvania?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, in two different directions. East on I-80, New Jersey's Kittatinny Ridge — Mount Tammany at the Delaware Water Gap and High Point, New Jersey's own state high point — is under an hour and a half. North and east, New York's Catskill high peaks (Slide and Wittenberg mountains, the range's two tallest summits) and the Hudson Highlands (Bear Mountain, Breakneck Ridge) are reachable within two hours."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Slide Mountain, the Catskills' high point, from Scranton?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": slide
          ? `Slide Mountain is roughly ${Math.round(slide.distance)} miles from ${slide.nearerCity}, about a ${slide.driveTime}-minute drive north through the Catskills — the tallest peak in the range and this guide's farthest-tier anchor to the north.`
          : "Slide Mountain is roughly 77 miles from Scranton, about a 103-minute drive north through the Catskills — the tallest peak in the range."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Scranton and Wilkes-Barre for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High Point, New Jersey's own state high point, is one of the gentler close-in options on this list despite its name — a well-marked, moderate approach with a fire tower at the top, roughly 70 minutes from Scranton."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Mount Tammany and the Delaware Water Gap from Scranton or Wilkes-Barre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": tammany
          ? `Mount Tammany is roughly ${Math.round(tammany.distance)} miles from ${tammany.nearerCity}, about a ${tammany.driveTime}-minute drive east on I-80 — the closest named-summit trail on this list and the anchor of the close-in Kittatinny Ridge cluster.`
          : "Mount Tammany is roughly 41 miles from Scranton, about a 55-minute drive east on I-80."
      }
    }
  ]
};

// LocalBusiness Schema for Scranton/Wilkes-Barre area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Scranton & Wilkes-Barre - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Scranton and Wilkes-Barre, Pennsylvania",
  "url": "https://summitseeker.io/near/scranton-wilkes-barre",
  "areaServed": [
    {
      "@type": "City",
      "name": "Scranton",
      "address": { "@type": "PostalAddress", "addressLocality": "Scranton", "addressRegion": "PA", "addressCountry": "US" }
    },
    {
      "@type": "City",
      "name": "Wilkes-Barre",
      "address": { "@type": "PostalAddress", "addressLocality": "Wilkes-Barre", "addressRegion": "PA", "addressCountry": "US" }
    }
  ]
};
