---
/**
 * Best Hikes Near Scranton & Wilkes-Barre, Pennsylvania
 * High-value SEO landing page targeting "hikes near scranton pa" and
 * "hikes near wilkes-barre pa"
 *
 * title: Best Hikes Near Scranton & Wilkes-Barre, PA 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Scranton and Wilkes-Barre, Pennsylvania —
 *   from New Jersey's Kittatinny Ridge to the Catskills' Slide Mountain and the Hudson Highlands,
 *   with real drive times, maps and difficulty ratings for every trail.
 * slug: scranton-wilkes-barre
 * date: 2026-08-30
 * targetKeywords: hikes near scranton pa, hikes near wilkes-barre pa, best hiking trails
 *   northeastern pennsylvania
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Scranton Wilkes-Barre Pennsylvania Poconos" surfaces
 *   discovernepa.com's own "short hikes with epic views" roundup, AllTrails and Yelp listings for
 *   each city separately, keystonenewsroom.com's ranked local list, and Komoot guides — all
 *   pointing at in-region parkland (Nay Aug Park's overlooks in Scranton, the Sugar Notch
 *   Ridgetop Trail and Bear Creek Preserve near Wilkes-Barre, Ricketts Glen's waterfalls, Big
 *   Pocono/Camelback Mountain at 2,100 feet) and rail-trails (the D&H Rail-Trail, the Lackawanna
 *   River Heritage Trail) — none of which are named-summit routes this site's database tracks,
 *   and none of which compute real drive times. None look past the Pennsylvania state line either,
 *   where three distinct ranges sit inside a two-hour drive: New Jersey's Kittatinny Ridge
 *   (Mount Tammany, less than an hour out), the Catskills (Slide Mountain, the range's own high
 *   point), and the Hudson Highlands (Bear Mountain, Storm King, Breakneck Ridge). Scranton and
 *   Wilkes-Barre aren't in cities.json (no programmatic page exists for either) and weren't
 *   hand-authored before this page. The data backs it: 31 publish-ready trails within 100 miles
 *   of whichever city is closer, Mount Tammany at 41 miles/55 minutes anchoring the close-in
 *   cluster, and Slide Mountain and the Hudson Highlands anchoring the farthest tier.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Scranton and Wilkes-Barre, PA coordinates
const scrantonLat = 41.4090;
const scrantonLon = -75.6624;
const wilkesBarreLat = 41.2459;
const wilkesBarreLon = -75.8813;

// Haversine distance in miles
const calculateDistance = (lat1, lon1, lat2, lon2) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Two starting cities, not one — each trail is scored against whichever of
// Scranton or Wilkes-Barre it's actually closer to, and that city's name
// travels with it through the page, same pattern as Worcester/Springfield
// and Manchester/Concord (the two cities sit only 16 miles apart, so most
// trails read nearly identically from either, but the exact nearer city
// still deserves the credited drive time).
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    const distScranton = calculateDistance(scrantonLat, scrantonLon, thLat, thLon);
    const distWilkesBarre = calculateDistance(wilkesBarreLat, wilkesBarreLon, thLat, thLon);
    const nearerCity = distScranton <= distWilkesBarre ? 'Scranton' : 'Wilkes-Barre';
    const distance = Math.min(distScranton, distWilkesBarre);
    return {
      ...m,
      distance,
      nearerCity,
      driveTime: Math.round(distance / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// The farthest tier is the actual differentiator here — the Catskills' Slide
// Mountain (the range's own high point) and the Hudson Highlands (Bear
// Mountain, Storm King, Breakneck Ridge) — so this deliberately takes the
// farthest 8 rather than the nearest 8 beyond 50mi, same deviation as
// Worcester/Springfield's Greylock anchor and for the same reason: a plain
// slice(0, 8) here would return only nearby New Jersey hills and miss every
// peak this page's own copy leans on.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(-8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const slideMountain = nearbyHikes.find(h => h.name === 'Slide Mountain');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Scranton or Wilkes-Barre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail is ${closestHikes[0]?.name}, on New Jersey's Kittatinny Ridge, roughly ${Math.round(closestHikes[0]?.distance)} miles (${closestHikes[0]?.driveTime} minutes) from ${closestHikes[0]?.nearerCity}.`
      }
    },
    {
      "@type": "Question",
      "name": "Is Slide Mountain a good day trip from Scranton or Wilkes-Barre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes. Slide Mountain, the highest peak in New York's Catskills, is${slideMountain ? ` about ${Math.round(slideMountain.distance)} miles (${slideMountain.driveTime} minutes)` : ' roughly 77 miles'} from ${slideMountain?.nearerCity || 'Scranton'} — a longer day trip, but inside the two-hour window, and a genuine summit rather than a local park hike.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Scranton and Wilkes-Barre?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Poconos around Scranton and Wilkes-Barre top out around 2,100 feet at Big Pocono/Camelback Mountain — real terrain, but not the kind of named-summit trail this guide tracks. The nearest tracked mountains are on New Jersey's Kittatinny Ridge, starting under an hour east, with the Catskills and the Hudson Highlands reachable as a farther day trip."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Scranton and Wilkes-Barre for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Several of the closer Kittatinny Ridge summits — New Jersey's own High Point, County House Mountain and Mount No More among them — are shorter, lower-elevation routes well suited to beginners, most within 70-75 minutes of Scranton or Wilkes-Barre."
      }
    },
    {
      "@type": "Question",
      "name": "Is Scranton or Wilkes-Barre closer to more hiking trails?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The two cities sit only about 16 miles apart, so almost every trail on this list reads nearly the same from either one. Scranton is marginally closer to the Kittatinny Ridge cluster; Wilkes-Barre is marginally closer to Armenia Mountain to the northwest — the difference is rarely more than a few minutes either way."
      }
    }
  ]
};

// LocalBusiness Schema for Scranton/Wilkes-Barre area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Scranton & Wilkes-Barre - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Scranton and Wilkes-Barre, Pennsylvania",
  "url": "https://summitseeker.io/near/scranton-wilkes-barre",
  "areaServed": [
    {
      "@type": "City",
      "name": "Scranton",
      "address": { "@type": "PostalAddress", "addressLocality": "Scranton", "addressRegion": "PA", "addressCountry": "US" }
    },
    {
      "@type": "City",
      "name": "Wilkes-Barre",
      "address": { "@type": "PostalAddress", "addressLocality": "Wilkes-Barre", "addressRegion": "PA", "addressCountry": "US" }
    }
  ]
};
