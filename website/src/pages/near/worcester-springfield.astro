---
/**
 * Best Hikes Near Worcester & Springfield, Massachusetts
 * High-value SEO landing page targeting "hikes near worcester ma" and
 * "hikes near springfield ma"
 *
 * title: Best Hikes Near Worcester & Springfield, MA 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Worcester and Springfield, Massachusetts —
 *   from Mount Wachusett to Massachusetts' own state high point at Mount Greylock, with real
 *   drive times, maps and difficulty ratings for every trail.
 * slug: worcester-springfield
 * date: 2026-08-26
 * targetKeywords: hikes near worcester ma, hikes near springfield ma, hiking trails central massachusetts
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Worcester" surfaces AllTrails, the Discover Central MA tourism
 *   site's own listicle, the City of Worcester's parks page, Yelp and a couple of local blogs —
 *   all pointing at in-city conservation land (the Cascades, Purgatory Chasm, Broad Meadow Brook)
 *   plus Mount Wachusett. "Best hikes near Springfield" surfaces onX, AllTrails, Komoot and Gaia
 *   GPS, all pointing at Pioneer Valley reservations (Mount Tom State Reservation, the Holyoke
 *   Range, Robinson State Park). None of these treat the two cities as one hiking region, none
 *   compute drive times from real trailhead coordinates, and none reach across the state line to
 *   the Litchfield Hills of Connecticut or west to Mount Greylock — Massachusetts' own state high
 *   point, less than 90 minutes from Springfield.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Worcester and Springfield, MA coordinates
const worcesterLat = 42.2626;
const worcesterLon = -71.8023;
const springfieldLat = 42.1015;
const springfieldLon = -72.5898;

// Haversine distance in miles
const calculateDistance = (lat1, lon1, lat2, lon2) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat2 - lat1) * Math.PI / 180;
  const dLon = (lon2 - lon1) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Two starting cities, not one — each trail is scored against whichever of
// Worcester or Springfield it's actually closer to, and that city's name
// travels with it through the page so a Springfield reader isn't shown a
// "22 min" badge that's only true from Worcester (Worcester's own cluster of
// nearby Rhode Island hills is real and genuinely closer to Worcester than
// almost anything is to Springfield — the two cities aren't symmetric here).
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    const distWorcester = calculateDistance(worcesterLat, worcesterLon, thLat, thLon);
    const distSpringfield = calculateDistance(springfieldLat, springfieldLon, thLat, thLon);
    const nearerCity = distWorcester <= distSpringfield ? 'Worcester' : 'Springfield';
    const distance = Math.min(distWorcester, distSpringfield);
    return {
      ...m,
      distance,
      nearerCity,
      driveTime: Math.round(distance / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// Anchor the farthest tier on Mount Greylock, Massachusetts' own state high
// point — same pattern as Pittsburgh's Mount Davis/Hoye-Crest and
// Philadelphia's Mount Tammany. slice(-8) takes the farthest 8 rather than
// re-selecting the same nearest trails a plain slice(0, 8) would.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(-8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

const greylock = nearbyHikes.find(h => h.slug === 'mount-greylock-ma');

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Worcester or Springfield?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail is ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes from ${closestHikes[0]?.nearerCity}).`
      }
    },
    {
      "@type": "Question",
      "name": "What is Mount Greylock and why is it worth hiking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mount Greylock is Massachusetts' state high point, at 3,489 feet in the Berkshires. It's the tallest mountain fully within the state, with a summit war memorial tower and sweeping views into New York, Vermont and New Hampshire on a clear day."
      }
    },
    {
      "@type": "Question",
      "name": "Is Worcester or Springfield closer to more hiking trails?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Worcester sits nearer to a cluster of low hills across the Rhode Island border, so its closest options tend to be a shorter drive. Springfield's nearest cluster runs south into Connecticut's Litchfield Hills and west toward the Berkshires — fewer trails within 30 minutes, but Mount Greylock and the Holyoke Range are both closer from Springfield than from Worcester."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Worcester and Springfield for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mount Wachusett's Semuhenna Trail loop outside Worcester and the low Rhode Island border hills like Badger Mountain and Benson Mountain are the gentlest of the bunch, most reachable in under 30 minutes with modest elevation gain."
      }
    }
  ]
};

// LocalBusiness Schema for Worcester/Springfield area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Worcester & Springfield - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Worcester and Springfield, Massachusetts",
  "url": "https://summitseeker.io/near/worcester-springfield",
  "areaServed": [
    {
      "@type": "City",
      "name": "Worcester",
      "address": { "@type": "PostalAddress", "addressLocality": "Worcester", "addressRegion": "MA", "addressCountry": "US" }
    },
    {
      "@type": "City",
      "name": "Springfield",
      "address": { "@type": "PostalAddress", "addressLocality": "Springfield", "addressRegion": "MA", "addressCountry": "US" }
    }
  ]
};
---

