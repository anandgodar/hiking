---
/**
 * Programmatic SEO page: "Best Hikes Near <City>"
 * Location: src/pages/near/[city].astro
 *
 * Generated for each metro in src/data-static/cities.json that has at least
 * 5 published trails within 100 miles — distance-sorted, all real data.
 * Hand-authored city pages (boston.astro, etc.) take precedence over this
 * dynamic route, so their slugs are excluded from cities.json.
 */
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import cities from '../../data-static/cities.json';

const RADIUS_MI = 100;
const MIN_TRAILS = 5;

export async function getStaticPaths() {
  const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
  const allMountains = Object.values(allFiles)
    .map(f => f.default || f)
    .filter(isPublishReady)
    .filter(m => m.lat && m.lon);

  const hav = (aLat, aLon, bLat, bLon) => {
    const R = 3959;
    const dLat = (bLat - aLat) * Math.PI / 180;
    const dLon = (bLon - aLon) * Math.PI / 180;
    const a = Math.sin(dLat / 2) ** 2 +
      Math.cos(aLat * Math.PI / 180) * Math.cos(bLat * Math.PI / 180) *
      Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  };

  return cities
    .map(city => {
      const hikes = allMountains
        .map(m => ({ ...m, milesAway: hav(city.lat, city.lon, m.lat, m.lon) }))
        .filter(m => m.milesAway <= 100)
        .sort((a, b) => a.milesAway - b.milesAway)
        .slice(0, 30);
      return { params: { city: city.slug }, props: { city, hikes } };
    })
    .filter(p => p.props.hikes.length >= 5);
}

const { city, hikes } = Astro.props;
const year = new Date().getFullYear();
const closest = hikes[0];

// "Trail Maps & Guides" pushed the longest city name (Colorado Springs, 21
// trails) to 62 characters — over the ~60-char render budget the rest of
// the site's titles are held to (homepage, state hub template). Trimmed to
// "Maps & Guides" gets every city, including Colorado Springs, back under
// 60 without losing "Best" or the trail count, both real ranking signals.
const title = `${hikes.length} Best Hikes Near ${city.name} | Maps & Guides ${year}`;
const description = `${hikes.length} hiking trails within ${RADIUS_MI} miles of ${city.name}, sorted by distance. Closest: ${closest.name} (${Math.round(closest.milesAway)} mi away). Maps, elevation profiles & parking for every trail.`.slice(0, 160);

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": `Best Hikes Near ${city.name}`,
  "numberOfItems": hikes.length,
  "itemListElement": hikes.slice(0, 25).map((m, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": m.name,
    "url": `https://summitseeker.io/${m.state_slug}/hikes/${m.slug}`,
  })),
};
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} slot="head" />

  <main class="min-h-screen bg-stone-50">
    <div class="max-w-6xl mx-auto px-4 py-12">
      <nav class="flex items-center gap-2 text-sm text-stone-500 mb-8">
        <a href="/" class="hover:text-emerald-700">Home</a>
        <span>/</span>
        <span class="text-stone-800 font-medium">Hikes Near {city.name}</span>
      </nav>

      <h1 class="font-serif text-4xl md:text-5xl font-black text-stone-900 mb-4">
        Best Hikes Near {city.name}
      </h1>
      <p class="text-lg text-stone-600 mb-10 max-w-3xl">
        {hikes.length} summit hikes within {RADIUS_MI} miles of {city.name},
        {city.state} — sorted by driving distance. The closest is
        <a href={`/${closest.state_slug}/hikes/${closest.slug}`}
           class="text-emerald-700 font-semibold hover:underline">{closest.name}</a>,
        about {Math.round(closest.milesAway)} miles away. Every trail links to a
        full guide with maps, elevation profiles and parking info.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {hikes.map(m => (
          <div class="relative">
            <MountainCard mountain={m} />
            <span class="absolute top-3 right-3 bg-white/90 text-stone-700 text-xs font-bold px-2 py-1 rounded-full shadow">
              {Math.round(m.milesAway)} mi away
            </span>
          </div>
        ))}
      </div>
    </div>
    <SiteFooter />
  </main>
</Layout>
