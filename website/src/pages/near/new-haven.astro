---
/**
 * Best Hikes Near New Haven, Connecticut
 * High-value SEO landing page targeting "hikes near new haven ct"
 *
 * slug: new-haven
 * date: 2026-08-26
 * targetKeywords: hikes near new haven ct, hiking trails near new haven connecticut, best hikes near new haven
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near New Haven CT" and "best hiking trails near me New Haven Connecticut"
 *   surface AllTrails, Yelp, onX, Gaia GPS, Komoot and a couple of local-tourism/blog listicles
 *   (onlyinyourstate.com, visitconnecticut.com) — all pointing at in-city or near-city parkland
 *   (East Rock Park, West Rock Ridge, Sleeping Giant State Park, Westwoods in Guilford, Lake
 *   Saltonstall). None of those are named-summit trails this site's database tracks, none compute
 *   drive times from real trailhead coordinates, and none mention that New Haven's position on
 *   I-95/the Merritt Parkway puts New York's Hudson Highlands (Bear Mountain, Storm King, Breakneck
 *   Ridge) in real day-trip range — a tier the existing Hartford page doesn't reach as cleanly,
 *   since Hartford's day trips lean toward the Berkshires instead.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// New Haven, CT coordinates
const newHavenLat = 41.3083;
const newHavenLon = -72.9279;

// Calculate distance from New Haven
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - newHavenLat) * Math.PI / 180;
  const dLon = (lon - newHavenLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(newHavenLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of New Haven and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(0, 8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to New Haven?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trails to New Haven are ${closestHikes[0]?.name} and ${closestHikes[1]?.name}, both roughly ${Math.round(closestHikes[0]?.distance)} miles (${closestHikes[0]?.driveTime} minutes) away in Connecticut's own Litchfield Hills cluster to the northwest.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near New Haven, CT?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, though New Haven sits closer to the coast than Hartford does, so it's a bit farther from Connecticut's own high terrain — roughly an hour northwest. The Litchfield Hills, including Bear Mountain (the highest summit located entirely within Connecticut, near Salisbury), start showing real forested ridgelines once you're inland of Waterbury."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near New Haven for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Litchfield Hills cluster closest to New Haven includes several shorter, lower-elevation routes well suited to beginners, most under an hour and fifteen minutes' drive with clearly marked blue-blazed trails."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Bear Mountain, NY and the Hudson Highlands from New Haven?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Bear Mountain State Park, Storm King and Breakneck Ridge in New York's Hudson Highlands are roughly 55 miles from New Haven — about a 75-minute drive via I-84 and the Taconic State Parkway. New Haven's position on I-95 and the Merritt Parkway puts this iconic Hudson River cluster within easier day-trip range than it is from Hartford."
      }
    }
  ]
};

// LocalBusiness Schema for New Haven area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near New Haven - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of New Haven, Connecticut",
  "url": "https://summitseeker.io/near/new-haven",
  "areaServed": {
    "@type": "City",
    "name": "New Haven",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "New Haven",
      "addressRegion": "CT",
      "addressCountry": "US"
    }
  }
};
---

<Layout
  title="Best Hikes Near New Haven, CT 2026 | Trails Within 2 Hours (With Drive Times)"
  description="Discover the best hiking trails near New Haven, Connecticut. From the Litchfield Hills to day trips into New York's Hudson Highlands, with real drive times, maps and difficulty ratings for every trail."
>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <!-- Hero Section -->
  <div class="relative h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden">
