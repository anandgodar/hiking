              <p class="text-stone-600">Worth the extra drive for real elevation — Connecticut ridgelines and Mount Monadnock, NH</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {dayTripHikes.map(mountain => (
              <div class="relative">
                <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
                <div class="absolute top-4 right-4 bg-cyan-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                  {mountain.driveTime} min
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- All Trails Section -->
      <section id="all" class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <div class="bg-purple-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">📍</div>
          <div>
            <h2 class="text-3xl font-bold text-stone-900">All {nearbyHikes.length} Trails Near Providence</h2>
            <p class="text-stone-600">Sorted by distance from Providence</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {nearbyHikes.map(mountain => (
