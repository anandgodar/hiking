---
/**
 * Best Hikes Near Providence, Rhode Island
 * High-value SEO landing page targeting "hikes near providence ri"
 *
 * slug: providence
 * date: 2026-08-25
 * targetKeywords: hikes near providence ri, hiking trails southern new england, best hikes rhode island
 * targetSite: summitseeker.io
 * competitorGap: Generic "near me" results for Providence are dominated by AllTrails/Tripadvisor
 *   listings with no drive-time context; no local editorial site (comparable to mainehikes.org for
 *   Portland ME) has claimed the Providence/southern-New-England city query. This page pairs RI's
 *   own low-elevation trail cluster with the closest CT/MA/NH day trips, computed from real
 *   trailhead coordinates rather than estimated.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Providence, RI coordinates
const providenceLat = 41.8240;
const providenceLon = -71.4128;

// Calculate distance from Providence
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - providenceLat) * Math.PI / 180;
  const dLon = (lon - providenceLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(providenceLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Providence and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(0, 8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Providence?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trails to Providence are ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes) and ${closestHikes[1]?.name} (${Math.round(closestHikes[1]?.distance)} miles, ${closestHikes[1]?.driveTime} minutes). Both sit inside Rhode Island's own cluster of low-elevation summits, well within a 30-minute drive of downtown.`
      }
    },
    {
      "@type": "Question",
      "name": "Are there real mountains near Providence, RI?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rhode Island's own hikes are hills rather than mountains — Jerimoth Hill, the state's highest point, tops out at 840 feet. For real elevation gain, southern New England hikers head north to Mount Monadnock in New Hampshire or west into Connecticut's ridgeline trails, both under a 2-hour drive from Providence."
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Providence for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Rhode Island's own trail cluster — Snake Den, Bare Rock, Cat Rocks and Round Rocks — offers easy, family-friendly hiking within 10 miles of the city, with short out-and-back routes and modest elevation gain."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Mount Monadnock from Providence?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mount Monadnock in New Hampshire is roughly 80 miles from Providence, making it a day-trip drive of about 1.5-2 hours. It's the nearest true mountain hike for Providence-area hikers looking for real summit views."
      }
    }
  ]
};

// LocalBusiness Schema for Providence area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Providence - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Providence, Rhode Island",
  "url": "https://summitseeker.io/near/providence",
  "areaServed": {
    "@type": "City",
    "name": "Providence",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Providence",
      "addressRegion": "RI",
      "addressCountry": "US"
    }
  }
};
---

<Layout
  title="Best Hikes Near Providence, RI 2026 | Trails Within 2 Hours (With Drive Times)"
  description="Discover the best hiking trails near Providence, Rhode Island. From easy hills in RI's own trail cluster to day trips into Connecticut and New Hampshire, with real drive times, maps and difficulty ratings for every trail."
>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <!-- Hero Section -->
  <div class="relative h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1508672019048-805c876b67e2?auto=format&fit=crop&q=80&w=2000"
