---
/**
 * Best Hikes Near Pittsburgh, Pennsylvania
 * High-value SEO landing page targeting "hikes near pittsburgh"
 *
 * title: Best Hikes Near Pittsburgh, PA 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Pittsburgh. From Pennsylvania's own state
 *   high point at Mount Davis to Maryland's Hoye-Crest in the Alleghenies, with real drive
 *   times, maps and difficulty ratings for every trail.
 * slug: pittsburgh
 * date: 2026-08-26
 * targetKeywords: hikes near pittsburgh, hiking trails near pittsburgh pa, best hikes near pittsburgh
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Pittsburgh" surfaces AllTrails, Pittsburgh Magazine's own
 *   10-trail roundup, VisitPittsburgh and discovertheburgh.com park guides, a Yogi Bear's
 *   Jellystone Park (Harrisville) blog post, mytrailsaremany.com's local-hiker guide, and
 *   komoot city guides. Every one of them points hikers to in-city parks (Frick Park, Schenley
 *   Park) or regional rail-trails built for walking and biking (the Montour Trail, the Great
 *   Allegheny Passage) rather than named mountain summits — Pittsburgh itself sits on the
 *   Allegheny Plateau with no real elevation nearby. None compute drive times from actual
 *   trailhead coordinates, and none mention that a roughly 60-90 minute drive south into the
 *   Laurel Highlands and Alleghenies reaches not one but two state high points this site's
 *   database already tracks: Pennsylvania's own Mount Davis and, just across the state line,
 *   Maryland's Hoye-Crest.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Pittsburgh, PA coordinates
const pghLat = 40.4406;
const pghLon = -79.9959;

// Calculate distance from Pittsburgh
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - pghLat) * Math.PI / 180;
  const dLon = (lon - pghLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(pghLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Pittsburgh and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
// Every trail near Pittsburgh is already >50mi (there's no in-town summit
// cluster the way Philadelphia or Providence have one), so slice(0, 8) here
// would just re-select the 8 nearest — the same trails as closestHikes —
// and silently drop Hoye-Crest, the farthest trail and the one this section
// explicitly promises. slice(-8) takes the farthest 8 instead.
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(-8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Pittsburgh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail to Pittsburgh is ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes), in the Laurel Highlands of southwestern Pennsylvania.`
      }
    },
    {
      "@type": "Question",
      "name": "What is Mount Davis and why is it worth hiking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Mount Davis is Pennsylvania's state high point, at 3,212 feet in the Negro Mountain range of the Laurel Highlands. It's an easy, mostly flat walk to an observation tower rather than a strenuous climb, but it's the highest ground in the entire state and less than an hour and a half from Pittsburgh."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Hoye-Crest, Maryland's state high point, from Pittsburgh?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Hoye-Crest, on Backbone Mountain just across the Maryland line, is about ${Math.round(nearbyHikes.find(h => h.slug === 'hoye-crest-md')?.distance || 90)} miles from Pittsburgh — roughly a two-hour drive. It's an easy out-and-back hike to Maryland's highest natural point.`
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Pittsburgh for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Laurel Highlands trails around Somerset County — Vought Rock, Packhorse Mountain, Baughman Rocks and Mount Davis itself — are the easiest of the bunch, all reachable in under 90 minutes with modest elevation gain."
      }
    }
  ]
};

// LocalBusiness Schema for Pittsburgh area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Pittsburgh - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Pittsburgh, Pennsylvania",
  "url": "https://summitseeker.io/near/pittsburgh",
  "areaServed": {
    "@type": "City",
    "name": "Pittsburgh",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Pittsburgh",
      "addressRegion": "PA",
      "addressCountry": "US"
    }
  }
};
---

<Layout
  title="Best Hikes Near Pittsburgh, PA 2026 | Trails Within 2 Hours (With Drive Times)"
  description="Discover the best hiking trails near Pittsburgh, from Pennsylvania's own state high point at Mount Davis to Maryland's Hoye-Crest in the Alleghenies, with real drive times, maps and difficulty ratings for every trail."
>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <!-- Hero Section -->
  <div class="relative h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1501554728187-ce583db33af7?auto=format&fit=crop&q=80&w=2000"
        class="w-full h-full object-cover"
        alt="Forested ridgeline hiking trail in the Laurel Highlands near Pittsburgh Pennsylvania"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-stone-900/70 via-stone-900/50 to-stone-900/80"></div>
    </div>

    <div class="relative z-10 w-full max-w-5xl px-4 text-center">
      <!-- Breadcrumb -->
      <nav class="mb-6" aria-label="Breadcrumb">
        <ol class="flex items-center justify-center gap-2 text-sm text-white/70">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li>/</li>
          <li><a href="/near" class="hover:text-white transition-colors">Near Me</a></li>
          <li>/</li>
          <li class="text-white font-medium">Pittsburgh</li>
        </ol>
      </nav>

      <div class="inline-block px-4 py-1.5 bg-blue-500/90 backdrop-blur-md rounded-full text-white text-xs font-bold uppercase tracking-wider mb-6">
        {nearbyHikes.length} Trails Within 100 Miles
      </div>

      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 tracking-tight leading-tight">
        Best Hikes Near <span class="text-blue-400">Pittsburgh</span>
      </h1>

      <p class="text-xl md:text-2xl text-white/90 mb-8 max-w-3xl mx-auto">
        {nearbyHikes.length} hiking trails within 100 miles of Pittsburgh, from the Laurel Highlands to two state high points
      </p>

      <div class="flex flex-wrap justify-center gap-3 text-sm">
        <div class="bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="text-white/80">Closest:</span> <span class="text-white font-bold">{Math.round(closestHikes[0]?.distance)} miles</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="text-white/80">Drive Time:</span> <span class="text-white font-bold">{closestHikes[0]?.driveTime} min - 2 hrs</span>
        </div>
        <div class="bg-white/10 backdrop-blur-md px-4 py-2 rounded-full border border-white/20">
          <span class="text-white/80">Difficulty:</span> <span class="text-white font-bold">Easy to Hard</span>
        </div>
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </div>

  <!-- Main Content -->
  <div class="bg-stone-50 py-16">
    <div class="max-w-7xl mx-auto px-4">

      <!-- Quick Navigation -->
      <div class="bg-white rounded-2xl shadow-lg p-6 mb-12 border border-stone-200">
        <h2 class="text-lg font-bold text-stone-900 mb-4">Jump to Section:</h2>
        <div class="flex flex-wrap gap-3">
          <a href="#closest" class="px-4 py-2 bg-blue-50 text-blue-700 rounded-lg hover:bg-blue-100 transition-colors font-medium text-sm">
            ⚡ Closest Trails
          </a>
          <a href="#easy" class="px-4 py-2 bg-emerald-50 text-emerald-700 rounded-lg hover:bg-emerald-100 transition-colors font-medium text-sm">
            🥾 Easy Hikes
          </a>
          <a href="#moderate" class="px-4 py-2 bg-amber-50 text-amber-700 rounded-lg hover:bg-amber-100 transition-colors font-medium text-sm">
            ⛰️ Moderate Hikes
          </a>
          <a href="#daytrips" class="px-4 py-2 bg-cyan-50 text-cyan-700 rounded-lg hover:bg-cyan-100 transition-colors font-medium text-sm">
            🚗 Farther Day Trips
          </a>
          <a href="#all" class="px-4 py-2 bg-purple-50 text-purple-700 rounded-lg hover:bg-purple-100 transition-colors font-medium text-sm">
            📍 All {nearbyHikes.length} Trails
          </a>
        </div>
      </div>

      <!-- Intro Content -->
      <div class="prose prose-lg max-w-4xl mx-auto mb-16 bg-white rounded-2xl p-8 shadow-sm border border-stone-200">
        <h2 class="text-3xl font-bold text-stone-900 mb-4">From the Laurel Highlands to Two State High Points</h2>

        <p class="text-stone-700 leading-relaxed">
          Pittsburgh itself sits on the Allegheny Plateau — steep river hills, but no real summits.
          Drive an hour or so south, though, and the Laurel Highlands rise into the Alleghenies
          around Somerset County, capped by Mount Davis — Pennsylvania's own state high point.
          Push a little farther across the Maryland line and you reach Hoye-Crest on Backbone
          Mountain, Maryland's highest natural point, tucked into the same ridge system.
        </p>

        <p class="text-stone-700 leading-relaxed">
          This guide covers all {nearbyHikes.length} trails within 100 miles of Pittsburgh, sorted by
          actual distance from real trailhead coordinates — not the city center. Each trail includes:
        </p>

        <ul class="space-y-2 text-stone-700">
          <li>✓ <strong>Exact distance from Pittsburgh</strong> (measured from the trailhead, not the summit)</li>
          <li>✓ <strong>Trail difficulty rating</strong> (easy, moderate, hard)</li>
          <li>✓ <strong>Elevation gain & distance</strong></li>
          <li>✓ <strong>Parking information & fees</strong></li>
          <li>✓ <strong>Interactive trail maps</strong></li>
          <li>✓ <strong>Real-time weather conditions</strong></li>
        </ul>
      </div>

      <!-- Closest Hikes Section -->
      {closestHikes.length > 0 && (
        <section id="closest" class="mb-16">
          <div class="flex items-center gap-4 mb-8">
            <div class="bg-blue-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">⚡</div>
            <div>
              <h2 class="text-3xl font-bold text-stone-900">5 Closest Trails to Pittsburgh</h2>
              <p class="text-stone-600">Perfect for a quick morning hike</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            {closestHikes.map(mountain => (
              <div class="relative">
                <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
                <div class="absolute top-4 right-4 bg-blue-500 text-white px-3 py-1 rounded-full text-sm font-bold shadow-lg">
                  {mountain.driveTime} min
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Easy Hikes Section -->
      {easyHikes.length > 0 && (
        <section id="easy" class="mb-16">
          <div class="flex items-center gap-4 mb-8">
            <div class="bg-emerald-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">🥾</div>
            <div>
              <h2 class="text-3xl font-bold text-stone-900">Best Easy Hikes Near Pittsburgh</h2>
              <p class="text-stone-600">The Laurel Highlands' gentler routes, great for beginners and families</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {easyHikes.map(mountain => (
              <div class="relative">
                <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
                <div class="absolute top-4 right-4 bg-emerald-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                  EASY
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Moderate Hikes Section -->
      {moderateHikes.length > 0 && (
        <section id="moderate" class="mb-16">
          <div class="flex items-center gap-4 mb-8">
            <div class="bg-amber-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">⛰️</div>
            <div>
              <h2 class="text-3xl font-bold text-stone-900">Moderate Hiking Trails</h2>
              <p class="text-stone-600">More climbing, still a manageable day trip</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {moderateHikes.map(mountain => (
              <div class="relative">
                <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
                <div class="absolute top-4 right-4 bg-amber-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                  MODERATE
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Farther Day Trips Section -->
      {dayTripHikes.length > 0 && (
        <section id="daytrips" class="mb-16">
          <div class="flex items-center gap-4 mb-8">
            <div class="bg-cyan-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">🚗</div>
            <div>
              <h2 class="text-3xl font-bold text-stone-900">Farther Day Trips</h2>
              <p class="text-stone-600">Worth the extra drive — Mount Davis and the Maryland high point at Hoye-Crest</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {dayTripHikes.map(mountain => (
              <div class="relative">
                <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
                <div class="absolute top-4 right-4 bg-cyan-500 text-white px-3 py-1 rounded-full text-xs font-bold shadow-lg">
                  {mountain.driveTime} min
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- All Trails Section -->
      <section id="all" class="mb-16">
        <div class="flex items-center gap-4 mb-8">
          <div class="bg-purple-500 w-12 h-12 rounded-2xl flex items-center justify-center text-2xl">📍</div>
          <div>
            <h2 class="text-3xl font-bold text-stone-900">All {nearbyHikes.length} Trails Near Pittsburgh</h2>
            <p class="text-stone-600">Sorted by distance from Pittsburgh</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {nearbyHikes.map(mountain => (
            <div class="relative">
              <MountainCard mountain={{...mountain, state_slug: normalizeState(mountain.state_slug)}} />
              <div class="absolute bottom-4 left-4 bg-black/70 text-white px-2 py-1 rounded text-xs font-bold">
                {Math.round(mountain.distance)} mi • {mountain.driveTime} min
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ Section -->
      <section class="bg-white rounded-2xl p-8 shadow-lg border border-stone-200 mb-16">
        <h2 class="text-3xl font-bold text-stone-900 mb-8">Frequently Asked Questions</h2>

        <div class="space-y-6">
          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-4 bg-stone-50 rounded-xl hover:bg-stone-100 transition-colors font-bold text-stone-900 list-none">
              <span>What is the closest hiking trail to Pittsburgh?</span>
              <svg class="w-5 h-5 text-emerald-600 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="p-4 text-stone-700 leading-relaxed">
              The closest hiking trail to Pittsburgh is <strong>{closestHikes[0]?.name}</strong>, located just {Math.round(closestHikes[0]?.distance)} miles away
              ({closestHikes[0]?.driveTime} minute drive), in the Laurel Highlands of southwestern Pennsylvania.
            </div>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-4 bg-stone-50 rounded-xl hover:bg-stone-100 transition-colors font-bold text-stone-900 list-none">
              <span>What is Mount Davis and why is it worth hiking?</span>
              <svg class="w-5 h-5 text-emerald-600 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="p-4 text-stone-700 leading-relaxed">
              Mount Davis is Pennsylvania's state high point — at 3,212 feet in the Negro Mountain
              range of the Laurel Highlands. It's an easy, mostly flat walk to an observation tower
              rather than a mountain climb, but it's the highest ground in the entire state and
              under an hour and a half from Pittsburgh.
            </div>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-4 bg-stone-50 rounded-xl hover:bg-stone-100 transition-colors font-bold text-stone-900 list-none">
              <span>How far is Hoye-Crest, Maryland's state high point, from Pittsburgh?</span>
              <svg class="w-5 h-5 text-emerald-600 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="p-4 text-stone-700 leading-relaxed">
              Hoye-Crest, on Backbone Mountain just across the Maryland line, is about {Math.round(nearbyHikes.find(h => h.slug === 'hoye-crest-md')?.distance || 90)} miles from Pittsburgh
              — roughly a two-hour drive. It's an easy out-and-back hike to Maryland's highest natural point.
            </div>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-4 bg-stone-50 rounded-xl hover:bg-stone-100 transition-colors font-bold text-stone-900 list-none">
              <span>What are the best easy hikes near Pittsburgh for beginners?</span>
              <svg class="w-5 h-5 text-emerald-600 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="p-4 text-stone-700 leading-relaxed">
              The Laurel Highlands trails around Somerset County — Vought Rock, Packhorse Mountain,
              Baughman Rocks and Mount Davis itself — are the easiest and closest, all reachable
              in under 90 minutes with modest elevation gain.
            </div>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-4 bg-stone-50 rounded-xl hover:bg-stone-100 transition-colors font-bold text-stone-900 list-none">
              <span>Do I need a parking pass for hiking trails near Pittsburgh?</span>
              <svg class="w-5 h-5 text-emerald-600 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="p-4 text-stone-700 leading-relaxed">
              Most Pennsylvania state forest trailheads in the Laurel Highlands are free. Maryland
              state park trailheads near Hoye-Crest and the Big Savage/Dans Mountain cluster
              typically require a small day-use fee in season. Check each trail's parking
              information page for specifics.
            </div>
          </details>

          <details class="group">
            <summary class="flex justify-between items-center cursor-pointer p-4 bg-stone-50 rounded-xl hover:bg-stone-100 transition-colors font-bold text-stone-900 list-none">
              <span>Can I hike near Pittsburgh in winter?</span>
              <svg class="w-5 h-5 text-emerald-600 transform transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="p-4 text-stone-700 leading-relaxed">
              Yes, but the Laurel Highlands and Alleghenies sit high enough to hold snow well into
              spring — Mount Davis and the Maryland high point cluster both see lake-effect snow
              off the Great Lakes. Bring microspikes and check conditions before heading up from
              December through March.
            </div>
          </details>
        </div>
      </section>

      <!-- Hiking Tips for Pittsburgh Area -->
      <section class="bg-gradient-to-br from-emerald-50 to-blue-50 rounded-2xl p-8 border border-emerald-200">
        <h2 class="text-2xl font-bold text-stone-900 mb-6">Essential Tips for Hiking Near Pittsburgh</h2>

        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <h3 class="font-bold text-stone-900 mb-3 flex items-center gap-2">
              <span class="text-2xl">🚗</span> Getting There
            </h3>
            <ul class="space-y-2 text-stone-700">
