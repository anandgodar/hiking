            <h2 class="text-3xl font-bold text-stone-900">All {nearbyHikes.length} Trails Near Philadelphia</h2>
            <p class="text-stone-600">Sorted by distance from Philadelphia</p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {nearbyHikes.map(mountain => (
