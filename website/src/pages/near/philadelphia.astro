---
/**
 * Best Hikes Near Philadelphia, Pennsylvania
 * High-value SEO landing page targeting "hikes near philadelphia"
 *
 * title: Best Hikes Near Philadelphia, PA 2026 | Trails Within 2 Hours (With Drive Times)
 * description: Discover the best hiking trails near Philadelphia. From Delaware's own state
 *   high point to the Kittatinny Ridge and Mount Tammany at the Delaware Water Gap, with real
 *   drive times, maps and difficulty ratings for every trail.
 * slug: philadelphia
 * date: 2026-08-25
 * targetKeywords: hikes near philadelphia, hiking trails near philadelphia pa, best hikes near philadelphia
 * targetSite: summitseeker.io
 * competitorGap: "Best hikes near Philadelphia" surfaces East Coast Hiker's own 18-trail listicle,
 *   Main Line Today and tomtoole.com suburban-hiking blog posts, plus Tripadvisor/Yelp/AllTrails/
 *   komoot generic listings — all pointing hikers toward in-city Wissahickon Valley Park (a real
 *   park with miles of trail but no distinct summit or elevation profile, so it isn't in this
 *   site's mountain database) or the Appalachian Trail's Pinnacle/Pulpit Rock near Hamburg, PA
 *   (also outside this database's current coverage). None of them compute real drive times from
 *   trailhead coordinates or sort by actual distance. This page instead uses the real named
 *   summits this site does have near Philadelphia: Delaware's Ebright Azimuth — the lowest state
 *   high point in the US, and a genuine only-in-Delaware curiosity — plus the Piedmont hills west
 *   of Wilmington, and the Kittatinny Ridge / NJ Highlands cluster capped by Mount Tammany at the
 *   Delaware Water Gap, a trail competitors themselves name as a top Philly-area day trip.
 */
import Layout from '../../layouts/Layout.astro';
import { isPublishReady } from '../../lib/publishReady.js';
import SiteFooter from '../../components/SiteFooter.astro';
import MountainCard from '../../components/MountainCard.astro';

// Load all mountains
const allFiles = import.meta.glob('../../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady); // route-complete trails only (no drafts)

// Philadelphia, PA coordinates
const phillyLat = 39.9526;
const phillyLon = -75.1652;

// Calculate distance from Philadelphia
const calculateDistance = (lat, lon) => {
  const R = 3959; // Earth's radius in miles
  const dLat = (lat - phillyLat) * Math.PI / 180;
  const dLon = (lon - phillyLon) * Math.PI / 180;
  const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
    Math.cos(phillyLat * Math.PI / 180) * Math.cos(lat * Math.PI / 180) *
    Math.sin(dLon/2) * Math.sin(dLon/2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  return R * c;
};

// Drive time from the actual trailhead coordinates in each trail's route data
// (geo.markers.start), not the summit pin — falls back to the summit lat/lon
// only when a trail has no recorded trailhead.
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') {
    return start;
  }
  return [m.lat, m.lon];
};

// Filter trails within 100 miles of Philadelphia and sort by distance
const nearbyHikes = allMountains
  .filter(m => m.lat && m.lon)
  .map(m => {
    const [thLat, thLon] = trailheadCoords(m);
    return {
      ...m,
      distance: calculateDistance(thLat, thLon),
      driveTime: Math.round(calculateDistance(thLat, thLon) / 45 * 60) // Rough estimate: 45mph avg on state roads
    };
  })
  .filter(m => m.distance <= 100 && m.driveTime <= 120) // matches the "within 2 hours" hero/title claim
  .sort((a, b) => a.distance - b.distance);

// Top picks by category
const closestHikes = nearbyHikes.slice(0, 5);
const easyHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('easy') || difficulty.toLowerCase().includes('beginner');
}).slice(0, 8);
const moderateHikes = nearbyHikes.filter(m => {
  const difficulty = m.trails?.[0]?.difficulty || m.trails?.[0]?.stats?.difficulty || '';
  return difficulty.toLowerCase().includes('moderate');
}).slice(0, 6);
const dayTripHikes = nearbyHikes.filter(m => m.distance > 50).slice(0, 8);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

// FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the closest hiking trail to Philadelphia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `The closest hiking trail to Philadelphia is ${closestHikes[0]?.name} (${Math.round(closestHikes[0]?.distance)} miles, ${closestHikes[0]?.driveTime} minutes), Delaware's own state high point just south of Wilmington.`
      }
    },
    {
      "@type": "Question",
      "name": "What is Ebright Azimuth and why is it worth hiking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ebright Azimuth is Delaware's state high point — at 449 feet, the lowest high point of any US state. It's an easy, short walk rather than a mountain climb, but it's a genuine hiking curiosity within a half hour of Wilmington and under an hour of Philadelphia."
      }
    },
    {
      "@type": "Question",
      "name": "How far is Mount Tammany and the Delaware Water Gap from Philadelphia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Mount Tammany, overlooking the Delaware Water Gap, is about ${Math.round(nearbyHikes.find(h => h.slug === 'mount-tammany-nj')?.distance || 70)} miles from Philadelphia — roughly a 90-minute drive north. It's the tallest, most dramatic day hike within range, with cliff-edge views over the Delaware River.`
      }
    },
    {
      "@type": "Question",
      "name": "What are the best easy hikes near Philadelphia for beginners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Piedmont hills just south of Wilmington — Ebright Azimuth, Horseshoe Hill and Drummond Hill — are the easiest and closest, all under 45 minutes from Philadelphia with modest elevation gain."
      }
    }
  ]
};

// LocalBusiness Schema for Philadelphia area
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "TouristInformationCenter",
  "name": "Best Hiking Trails Near Philadelphia - Summit Seeker",
  "description": "Comprehensive guide to the best hiking trails within 100 miles of Philadelphia, Pennsylvania",
  "url": "https://summitseeker.io/near/philadelphia",
  "areaServed": {
    "@type": "City",
    "name": "Philadelphia",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Philadelphia",
      "addressRegion": "PA",
      "addressCountry": "US"
    }
  }
};
---

<Layout
  title="Best Hikes Near Philadelphia, PA 2026 | Trails Within 2 Hours (With Drive Times)"
  description="Discover the best hiking trails near Philadelphia, from Delaware's state high point to Mount Tammany at the Delaware Water Gap, with real drive times, maps and difficulty ratings for every trail."
>

  <!-- Schema Markup -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} slot="head" />

  <!-- Hero Section -->
  <div class="relative h-[60vh] min-h-[500px] flex items-center justify-center overflow-hidden">
