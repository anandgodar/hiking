---
/**
 * Homepage - Main Site Index
 * Location: src/pages/index.astro
 *
 * FIXED: All URLs now include /hikes/ path segment
 * FIXED: All emojis replaced with SVG icons
 * FIXED: State search filter now functional
 */
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MountainCard from '../components/MountainCard.astro';
import GlobalSearch from '../components/GlobalSearch.astro';
import HomepageFAQ from '../components/HomepageFAQ.astro';
import { isPublishReady } from '../lib/publishReady.js';
import cities from '../data-static/cities.json';

// Load all mountains (route-complete only — drafts/stubs are hidden)
const allFiles = import.meta.glob('../data/*/*.json', { eager: true });
const allMountains = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady);

// Normalize state slug
const normalizeState = (s) => {
  if (s === 'nh') return 'new-hampshire';
  if (s === 'me') return 'maine';
  if (s === 'vt') return 'vermont';
  if (s === 'ny') return 'new-york';
  return s;
};

// Search Index - FIXED: Added /hikes/ to URL
const searchIndex = allMountains.map(m => ({
  title: m.name,
  type: 'Mountain',
  subtitle: m.state || m.state_slug,
  url: `/${normalizeState(m.state_slug)}/hikes/${m.slug}`,
  image: m.mountain_hero || m.image,
  tags: m.tags || []
}));

// Group by state
const stateGroups = {};
allMountains.forEach(m => {
  const state = normalizeState(m.state_slug);
  if (!stateGroups[state]) stateGroups[state] = [];
  stateGroups[state].push(m);
});

// Featured categories - NO EMOJIS
const categories = [
  { id: '4000-footer', title: '4000 Footers', icon: 'mountain' },
  { id: 'waterfall', title: 'Waterfalls', icon: 'water' },
  { id: 'view', title: 'With a View', icon: 'eye' },
  { id: 'fire-tower', title: 'Fire Towers', icon: 'tower' },
];

// State cards — built dynamically from the data so any imported state
// appears automatically. Each card uses a real photo from that state's own
// trails (Wikimedia Commons heroes, highest peak first) so no two states
// share an image.
const DEFAULT_STATE_IMAGE = 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&q=80&w=800';
// States whose live peaks have no Commons photos get a famous in-state
// landmark instead (Wikipedia lead images, all Commons-hosted).
const fp = (f) => `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(f)}?width=800`;
const STATE_IMAGE_OVERRIDES = {
  'hawaii': fp('Mauna_Kea_from_the_ocean.jpg'),
  'indiana': fp('Indiana_Dunes_National_Lakeshore,_Michigan_City,_Indiana,_Estados_Unidos,_2012-10-20,_DD_03.jpg'),
  'mississippi': fp('TishomingoSPbridge.jpg'),
  'nebraska': fp('Covered_Wagon_In_Scotts_Bluff_National_Monument,_Nebraska.jpg'),
  'west-virginia': fp('Seneca_Rocks_-_front_1.jpg'),
};
const titleCase = (slug) => slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

const stateHero = (mountains) => {
  // Only attributed Commons photos count — a generic stock hero would put
  // the same image on many state cards.
  const withPhoto = mountains
    .filter(m => m.mountain_hero && m.hero_credit)
    .sort((a, b) => (b.elevation || 0) - (a.elevation || 0));
  const pick = withPhoto[0];
  if (!pick) return null;
  // Cards render small — ask Commons for 800px instead of the 1600px hero.
  return pick.mountain_hero.replace('width=1600', 'width=800');
};

const states = Object.keys(stateGroups)
  .map(slug => ({
    slug,
    name: stateGroups[slug][0]?.state || titleCase(slug),
    image: stateHero(stateGroups[slug]) || STATE_IMAGE_OVERRIDES[slug] || DEFAULT_STATE_IMAGE,
    count: stateGroups[slug].length,
  }))
  .sort((a, b) => b.count - a.count);

// Top rated mountains
const topMountains = allMountains
  .sort((a, b) => (b.elevation || 0) - (a.elevation || 0))
  .slice(0, 4);

// Icon SVG helper
const getIconSvg = (iconName) => {
  const icons = {
    mountain: '<path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z"/>',
    water: '<path d="M12 2c-5.33 4.55-8 8.48-8 11.8 0 4.98 3.8 8.2 8 8.2s8-3.22 8-8.2c0-3.32-2.67-7.25-8-11.8z"/>',
    eye: '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>',
    paw: '<path d="M4.5 12c-.83 0-1.5-.67-1.5-1.5S3.67 9 4.5 9 6 9.67 6 10.5 5.33 12 4.5 12zm3-4C6.67 8 6 7.33 6 6.5S6.67 5 7.5 5 9 5.67 9 6.5 8.33 8 7.5 8zm5-1c-.83 0-1.5-.67-1.5-1.5S11.67 4 12.5 4s1.5.67 1.5 1.5S13.33 7 12.5 7zm4 1c-.83 0-1.5-.67-1.5-1.5S15.67 5 16.5 5s1.5.67 1.5 1.5S17.33 8 16.5 8zm3 4c-.83 0-1.5-.67-1.5-1.5S18.67 9 19.5 9s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>',
    tower: '<path d="M12 2L4 5v6.09c0 5.05 3.41 9.76 8 10.91 4.59-1.15 8-5.86 8-10.91V5l-8-3zm6 9.09c0 4-2.55 7.7-6 8.83-3.45-1.13-6-4.82-6-8.83V6.31l6-2.25 6 2.25v4.78z"/>',
    location: '<path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>',
    compass: '<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-5.5-2.5l7.51-3.49L17.5 6.5 9.99 9.99 6.5 17.5zm5.5-6.6c.61 0 1.1.49 1.1 1.1s-.49 1.1-1.1 1.1-1.1-.49-1.1-1.1.49-1.1 1.1-1.1z"/>'
  };
  return icons[iconName] || icons.mountain;
};

// States with trails for filter
const activeStates = states.filter(s => s.count > 0);

// City landing pages (near/[city]) — same ≥5-trails-within-100mi rule as the
// page generator, so every chip links to a page that exists.
const havMi = (aLat, aLon, bLat, bLon) => {
  const R = 3959;
  const dLat = (bLat - aLat) * Math.PI / 180;
  const dLon = (bLon - aLon) * Math.PI / 180;
  const a = Math.sin(dLat / 2) ** 2 +
    Math.cos(aLat * Math.PI / 180) * Math.cos(bLat * Math.PI / 180) * Math.sin(dLon / 2) ** 2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
};
const HAND_MADE_CITIES = [
  { slug: 'boston', name: 'Boston', lat: 42.3601, lon: -71.0589 },
  { slug: 'new-york-city', name: 'New York City', lat: 40.7128, lon: -74.006 },
  { slug: 'san-francisco', name: 'San Francisco', lat: 37.7749, lon: -122.4194 },
  { slug: 'los-angeles', name: 'Los Angeles', lat: 34.0522, lon: -118.2437 },
  { slug: 'portland-maine', name: 'Portland, ME', lat: 43.6591, lon: -70.2568 },
  { slug: 'burlington-vermont', name: 'Burlington, VT', lat: 44.4759, lon: -73.2121 },
  { slug: 'providence', name: 'Providence, RI', lat: 41.8240, lon: -71.4128 },
  { slug: 'hartford', name: 'Hartford, CT', lat: 41.7658, lon: -72.6734 },
  { slug: 'albany', name: 'Albany, NY', lat: 42.6526, lon: -73.7562 },
  { slug: 'philadelphia', name: 'Philadelphia, PA', lat: 39.9526, lon: -75.1652 },
  { slug: 'pittsburgh', name: 'Pittsburgh, PA', lat: 40.4406, lon: -79.9959 },
  { slug: 'worcester-springfield', name: 'Worcester & Springfield, MA', lat: 42.2626, lon: -71.8023, lat2: 42.1015, lon2: -72.5898 },
  { slug: 'new-haven', name: 'New Haven, CT', lat: 41.3083, lon: -72.9279 },
  { slug: 'manchester-concord', name: 'Manchester & Concord, NH', lat: 42.9956, lon: -71.4548, lat2: 43.2081, lon2: -71.5376 },
  { slug: 'poughkeepsie', name: 'Poughkeepsie, NY', lat: 41.7004, lon: -73.9210 },
  { slug: 'allentown', name: 'Allentown, PA', lat: 40.6084, lon: -75.4902 },
];
// Hand-authored pages filter on trailhead coordinates + a 120-minute drive
// cap (see e.g. near/albany.astro), not just summit-to-summit distance — so
// their chip counts need the same predicate or they advertise a number the
// page itself doesn't show (Providence and Burlington VT were off by 19 and
// 25 before this fix). Programmatic cities keep the simpler distance-only
// predicate because that's exactly what near/[city].astro itself generates.
const handMadeSlugs = new Set(HAND_MADE_CITIES.map(c => c.slug));
const trailheadCoords = (m) => {
  const start = m.trails?.[0]?.geo?.markers?.start;
  if (Array.isArray(start) && typeof start[0] === 'number' && typeof start[1] === 'number') return start;
  return [m.lat, m.lon];
};
const cityLinks = [...HAND_MADE_CITIES, ...cities]
  .map(c => ({
    ...c,
    count: handMadeSlugs.has(c.slug)
      ? allMountains.filter(m => {
          if (!m.lat || !m.lon) return false;
          const [thLat, thLon] = trailheadCoords(m);
          // Worcester & Springfield is a two-origin page — a trail counts if
          // it's within range of *either* city, same as the page's own
          // nearerCity logic, not just the first coordinate.
          const mi = c.lat2 != null
            ? Math.min(havMi(c.lat, c.lon, thLat, thLon), havMi(c.lat2, c.lon2, thLat, thLon))
            : havMi(c.lat, c.lon, thLat, thLon);
          return mi <= 100 && Math.round(mi / 45 * 60) <= 120;
        }).length
      : allMountains.filter(m => m.lat && m.lon &&
          havMi(c.lat, c.lon, m.lat, m.lon) <= 100).length,
  }))
  .filter(c => c.count >= 5)
  .sort((a, b) => b.count - a.count);
---

<Layout
  title="Best Hiking Trails in the USA (2026) | Maps & Guides"
  description={`Discover hiking trails across ${activeStates.length} states with detailed maps, elevation profiles & real-time weather. Every route from verified public sources.`}
>

  <!-- HERO SECTION -->
  <div class="relative min-h-screen flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&q=80&w=2000"
        class="w-full h-full object-cover"
        fetchpriority="high"
        alt="Majestic mountain peaks and alpine wilderness landscape with hiking trails and forest scenery"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-stone-900/60 via-stone-900/40 to-stone-900/80"></div>
    </div>

    <div class="relative z-10 w-full max-w-5xl px-4 text-center">
      <!-- Tagline -->
      <p class="text-white/60 text-sm font-bold uppercase tracking-[0.3em] mb-4">
        Discover America's Best
      </p>
      <h1 class="text-5xl md:text-7xl font-black text-white mb-4 tracking-tight leading-tight">
        <span class="text-emerald-400">Hiking Trails</span> Across the USA
      </h1>
      <p class="text-white/80 text-lg md:text-xl mb-6 max-w-3xl mx-auto">
        Comprehensive trail guides with detailed maps, elevation profiles & real-time weather across {activeStates.length} states
      </p>
      <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md border border-white/20 rounded-full text-white/90 text-sm mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        {allMountains.length}+ trail guides across {activeStates.length} states — every one with a verified route
      </div>

      <!-- Search Bar -->
      <div class="max-w-2xl mx-auto mt-8 mb-8">
        <GlobalSearch searchIndex={searchIndex} />
      </div>

      <!-- Explore Map CTA -->
      <div class="flex justify-center mt-2 mb-2">
        <a href="/map"
           class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-500 text-white font-bold rounded-full hover:bg-emerald-400 transition-colors shadow-lg shadow-emerald-900/30">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
          Explore the Trail Map
        </a>
      </div>

      <!-- Category Pills - SVG icons, discover pages -->
      <div class="flex flex-wrap justify-center gap-3 mt-8">
        {categories.map(cat => (
          <a
            href={`/discover/${cat.id}`}
            class="flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md border border-white/20 rounded-full text-white text-sm font-bold hover:bg-white/20 transition-all"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" set:html={getIconSvg(cat.icon)} />
            {cat.title}
          </a>
        ))}
      </div>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </div>

  <!-- SELECT YOUR REGION -->
  <section class="bg-stone-50 py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="flex items-center gap-3 mb-8">
        <svg class="w-8 h-8 text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <h2 class="text-3xl font-bold text-stone-900">Select Your Region</h2>
      </div>

      <!-- SEARCH & FILTER BAR -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
        <div class="relative flex-1 max-w-md">
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="state-filter"
            placeholder="Search states (e.g., New Hampshire, Maine...)"
            class="w-full pl-12 pr-4 py-3 border border-stone-200 rounded-2xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-transparent shadow-sm bg-white"
          />
        </div>
        <div class="flex items-center gap-3">
          <span class="text-sm text-stone-500 hidden sm:block" id="state-count">
            {activeStates.length} regions available
          </span>
          <button
            id="clear-filter"
            style:"display: none;"
            class="hidden items-center gap-2 px-3 py-2 text-stone-500 hover:text-stone-700 text-sm font-medium transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
            Clear
          </button>
        </div>
      </div>

      <!-- NO RESULTS MESSAGE (hidden by default) -->
      <div id="no-results" class="hidden text-center py-12">
        <svg class="w-16 h-16 mx-auto text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-stone-500 font-medium">No regions match your search</p>
        <button id="reset-search" class="mt-4 text-emerald-600 font-bold hover:underline">
          Show all regions
        </button>
      </div>

      <!-- STATE CARDS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="states-grid">
        {activeStates.map(state => (
          <a
            href={`/${state.slug}`}
            class="state-card group relative h-64 rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all hover:-translate-y-1"
            data-state-name={state.name.toLowerCase()}
            data-state-slug={state.slug}
          >
            <img
              src={state.image}
              alt={`${state.name} hiking trails and mountain peaks - explore ${state.count} curated trails across ${state.name} wilderness areas`}
              class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"></div>
            <div class="absolute bottom-4 left-4 text-white">
              <h3 class="text-xl font-bold">{state.name}</h3>
              <p class="text-white/70 text-sm">{state.count} adventures</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FIND HIKES NEAR YOU — city landing pages -->
  {cityLinks.length > 0 && (
    <section class="py-16 bg-white border-y border-stone-200">
      <div class="max-w-6xl mx-auto px-4">
        <p class="text-emerald-700 text-sm font-bold uppercase tracking-[0.2em] mb-2 text-center">
          Local Trails
        </p>
        <h2 class="font-serif text-3xl md:text-4xl font-black text-stone-900 text-center mb-3">
          Find Hikes Near You
        </h2>
        <p class="text-stone-500 text-center mb-10 max-w-xl mx-auto">
          Distance-sorted trail guides within 100 miles of {cityLinks.length} cities.
        </p>
        <div class="flex flex-wrap justify-center gap-3">
          {cityLinks.map(c => (
            <a href={`/near/${c.slug}`}
               class="group flex items-center gap-2 px-4 py-2.5 bg-stone-50 border border-stone-200 rounded-full text-stone-800 text-sm font-semibold hover:border-emerald-500 hover:bg-emerald-50 hover:text-emerald-800 transition-all">
              <svg class="w-4 h-4 text-stone-400 group-hover:text-emerald-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              {c.name}
              <span class="text-xs font-bold text-emerald-700 bg-emerald-100 rounded-full px-2 py-0.5">{c.count}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- COMING SOON STATES -->
  <section class="bg-gradient-to-br from-emerald-600 to-emerald-800 py-16">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-white/20 backdrop-blur-md border border-white/30 rounded-full text-white text-xs font-bold uppercase tracking-wider mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Nationwide Expansion in Progress
      </div>

      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Expanding to All 50 States</h2>
      <p class="text-emerald-100 text-lg md:text-xl max-w-3xl mx-auto mb-12">
        We're rapidly adding trails across America. Next up: California, Colorado, Washington, Arizona & more!
      </p>

      <div class="grid grid-cols-2 md:grid-cols-5 gap-4 max-w-4xl mx-auto">
        {[
          { name: 'Colorado', trails: '150+' },
          { name: 'Washington', trails: '120+' },
          { name: 'Arizona', trails: '100+' },
          { name: 'Utah', trails: '100+' },
          { name: 'Oregon', trails: '100+' },
          { name: 'North Carolina', trails: '80+' },
          { name: 'Tennessee', trails: '80+' },
          { name: 'Montana', trails: '80+' },
          { name: 'Wyoming', trails: '70+' },
          { name: 'Alaska', trails: '60+' }
        ].map(state => (
          <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-xl p-4 hover:bg-white/20 transition-all">
            <svg class="w-8 h-8 mx-auto mb-2 text-emerald-200" fill="currentColor" viewBox="0 0 24 24">
              <path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z"/>
            </svg>
            <div class="text-white font-bold text-sm mb-1">{state.name}</div>
            <div class="text-emerald-200 text-xs">{state.trails} trails</div>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <p class="text-white/90 text-sm mb-4">Want to see your state added first?</p>
        <a href="mailto:hello@summitseeker.io?subject=State Request" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-emerald-700 font-bold rounded-xl hover:bg-emerald-50 transition-colors shadow-xl">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Request Your State
        </a>
      </div>
    </div>
  </section>

  <!-- LEGENDARY ADVENTURES -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-stone-900 mb-2">Legendary Adventures</h2>
        <p class="text-stone-500">Highest rated climbs across the entire database.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {topMountains.map(m => (
          <MountainCard mountain={{...m, state_slug: normalizeState(m.state_slug)}} />
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <HomepageFAQ />

  <SiteFooter />
</Layout>

<script>
  // State filter functionality
  const filterInput = document.getElementById('state-filter');
  const statesGrid = document.getElementById('states-grid');
  const stateCards = document.querySelectorAll('.state-card');
  const stateCount = document.getElementById('state-count');
  const noResults = document.getElementById('no-results');
  const clearBtn = document.getElementById('clear-filter');
  const resetBtn = document.getElementById('reset-search');
  const totalStates = stateCards.length;

  function filterStates(query) {
    const searchQuery = query.toLowerCase().trim();
    let visibleCount = 0;

    stateCards.forEach(card => {
      const stateName = card.dataset.stateName || '';
      const stateSlug = card.dataset.stateSlug || '';
      const matches = !searchQuery ||
                      stateName.includes(searchQuery) ||
                      stateSlug.includes(searchQuery);

      if (matches) {
        card.style.display = 'block';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    // Update count text
    if (stateCount) {
      stateCount.textContent = searchQuery
        ? `${visibleCount} of ${totalStates} regions`
        : `${totalStates} regions available`;
    }

    // Show/hide no results message
    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // Show/hide clear button
    if (clearBtn) {
      clearBtn.style.display = searchQuery ? 'flex' : 'none';
    }

    // Show/hide grid
    if (statesGrid) {
      statesGrid.style.display = visibleCount === 0 ? 'none' : 'grid';
    }
  }

  function clearFilter() {
    if (filterInput) {
      filterInput.value = '';
      filterStates('');
      filterInput.focus();
    }
  }

  // Event listeners
  filterInput?.addEventListener('input', (e) => {
    filterStates(e.target.value);
  });

  clearBtn?.addEventListener('click', clearFilter);
  resetBtn?.addEventListener('click', clearFilter);

  // Handle Enter key - navigate to first visible state
  filterInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      const firstVisible = document.querySelector('.state-card[style="display: block;"], .state-card:not([style*="display: none"])');
      if (firstVisible) {
        window.location.href = firstVisible.href;
      }
    }
  });
</script>