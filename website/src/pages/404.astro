---
/**
 * 404 page — keeps lost visitors on the trail instead of bouncing.
 * Static hosts serve dist/404.html automatically (Netlify, Vercel, CF Pages);
 * for nginx/Apache point the error page at /404.html.
 */
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { isPublishReady } from '../lib/publishReady.js';

const allFiles = import.meta.glob('../data/*/*.json', { eager: true });
const suggestions = Object.values(allFiles)
  .map(f => f.default || f)
  .filter(isPublishReady)
  .sort((a, b) => (b.elevation || 0) - (a.elevation || 0))
  .slice(0, 6);
---

<Layout title="Page Not Found | Summit Seeker"
        description="That trail doesn't exist — but 700+ real ones do.">
  <main class="min-h-screen bg-stone-50 flex flex-col">
    <div class="flex-1 flex items-center justify-center px-4 py-20">
      <div class="text-center max-w-2xl">
        <p class="font-mono text-7xl font-black text-emerald-700 mb-4">404</p>
        <h1 class="font-serif text-3xl md:text-4xl font-black text-stone-900 mb-3">
          You've wandered off the trail
        </h1>
        <p class="text-stone-600 mb-8">
          This page doesn't exist — maybe the trail moved, or the link was wrong.
          Here are some summits to get you back on route:
        </p>
        <div class="flex flex-wrap justify-center gap-2 mb-8">
          {suggestions.map(m => (
            <a href={`/${m.state_slug}/hikes/${m.slug}`}
               class="px-4 py-2 bg-white border border-stone-200 rounded-full text-sm font-semibold text-stone-800 hover:border-emerald-500 hover:text-emerald-700 transition-colors">
              {m.name} · {m.elevation?.toLocaleString()} ft
            </a>
          ))}
        </div>
        <a href="/" class="inline-block px-6 py-3 bg-emerald-700 text-white font-bold rounded-lg hover:bg-emerald-800 transition-colors">
          Back to the Homepage
        </a>
      </div>
    </div>
    <SiteFooter />
  </main>
</Layout>
